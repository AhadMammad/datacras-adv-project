// crm_db: Salesforce Sales Cloud (CRM). Generated by advgen from the pinned Advertising MVM; do not edit by hand. Regenerate with `uv run advgen build`.

Project crm_db {
  database_type: 'PostgreSQL'
  Note: 'Advertiser identity, brands, account teams, client briefs and every commercial agreement (MSA, SOW, SLA, rate cards, client-side IOs).'
}

Table ref.role [note: 'Code set. Values: Account Director, Strategic Planner, Media Lead, Creative Director, Account Manager, Media Buyer, Digital Strategist, Data Analyst, PR Lead, Brand Strategist'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

