// erp_db: SAP S/4HANA (FI/CO, AP/AR). Generated by advgen from the pinned Advertising MVM; do not edit by hand. Regenerate with `uv run advgen build`.

Project erp_db {
  database_type: 'PostgreSQL'
  Note: 'Finance master data (cost centers, GL accounts, budgets), client invoicing, revenue recognition, payments, vendor invoices, payables and media cost reconciliation.'
}

Table ref.delivery_data_source [note: 'Code set. Values: cm360, the_trade_desk, mediaocean_prisma, nielsen, comscore, vendor_reported, other'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table ref.discrepancy_reason_code [note: 'Code set. Values: delivery_shortfall, overbilling, trafficking_error, data_discrepancy, invalid_traffic, make_good, other, ad_fraud, brand_safety_block, viewability_adjustment, billing_error, makegood_offset'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

