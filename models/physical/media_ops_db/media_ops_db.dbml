// media_ops_db: Mediaocean Prisma (media planning and buying). Generated by advgen from the pinned Advertising MVM; do not edit by hand. Regenerate with `uv run advgen build`.

Project media_ops_db {
  database_type: 'PostgreSQL'
  Note: 'Campaign structure, media plans, placements, buys, insertion orders, programmatic deals, trafficking and the vendor/publisher registry with rate cards.'
}

