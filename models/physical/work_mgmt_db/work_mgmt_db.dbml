Table creative.brand_guideline [note: 'Reference master for client brand guidelines governing creative production — including approved color palettes (hex, Pantone, CMYK, RGB), typography (typefaces, weights, sizes), logo usage rules, imagery style, tone of voice, do/don\'t examples, and brand compliance thresholds. Serves as the SSOT for brand compliance validation during creative review and production QA. Scope boundary: this entity owns the operational production ruleset (visual specs, typography rules, logo placement constraints) used by creative teams in day-to-day asset production. It does NOT own brand strategy, positioning, architecture, or competitive intelligence — those belong to the brand domain. Sourced from client brand portals and maintained by the creative services team.'] {
  brand_guideline_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the creative brand guideline record. Primary key.']
  brand_id uuid [note: 'Reference to the client brand that this guideline governs. Links to the client brand master. [→ crm_db.client.brand (not enforced)]']
  approval_authority text [note: 'The person or role with authority to approve changes to this brand guideline (e.g., \'Chief Brand Officer\', \'Client CMO\').']
  compliance_threshold_score numeric(5,2) [note: 'Minimum compliance score (0-100) required for creative assets to pass brand compliance validation during review and production QA.']
  compliance_validation_enabled boolean [not null, default: false, note: 'Flag indicating whether automated brand compliance validation is enabled for creative assets produced under this guideline.']
  digital_asset_management_url text [note: 'URL or reference to the location of the full brand guideline document in the Digital Asset Management system (e.g., Workfront DAM, Adobe Experience Manager).']
  do_examples text [note: 'Positive examples demonstrating correct application of brand guidelines. Used for training and reference during creative production.']
  dont_examples text [note: 'Negative examples showing incorrect or prohibited uses of brand elements. Critical for compliance validation and creative QA.']
  effective_date date [not null, note: 'The date from which this brand guideline becomes active and enforceable for creative production.']
  expiration_date date [note: 'The date on which this brand guideline is no longer valid or has been superseded. Nullable for guidelines with no planned end date.']
  format_specifications text [note: 'Technical specifications for creative asset formats including file types, dimensions, resolution, color space, and compression standards for different channels (digital, print, OOH, OTT, CTV).']
  guideline_description text [note: 'Detailed description of the scope, purpose, and coverage of this brand guideline document.']
  guideline_status text [not null, note: 'Current lifecycle status of the brand guideline. Indicates whether the guideline is in draft, actively used, archived, superseded by a newer version, or under review. [guideline_status IN (\'draft\', \'active\', \'archived\', \'superseded\', \'under_review\')]']
  guideline_version text [not null, note: 'Version identifier for this brand guideline (e.g., \'v3.2\', \'2024.1\'). Supports version control and change tracking.']
  imagery_style_guidelines text [note: 'Guidelines governing photography and imagery style including subject matter, composition, lighting, color treatment, and mood. Ensures visual consistency.']
  last_reviewed_date date [note: 'The date when this brand guideline was last reviewed for accuracy and relevance.']
  logo_clear_space_minimum text [note: 'Minimum clear space required around the logo, typically expressed as a multiple of a logo element (e.g., \'2x height of logo mark\').']
  logo_minimum_size text [note: 'Minimum allowable size for logo reproduction across different media (print, digital, OOH), ensuring legibility and brand integrity.']
  logo_usage_rules text [note: 'Comprehensive rules for logo placement, sizing, clear space, minimum size, color variations, and prohibited uses. Critical for brand compliance validation.']
  messaging_guidelines text [note: 'Key messaging pillars, brand promises, value propositions, and approved language for brand communications.']
  next_review_date date [note: 'The scheduled date for the next review of this brand guideline to ensure it remains current and aligned with brand strategy.']
  primary_color_palette text [note: 'Approved primary brand colors in multiple formats (hex, Pantone, CMYK, RGB). Stored as structured text or JSON for parsing by creative tools.']
  primary_typeface text [note: 'The primary approved typeface or font family for brand communications (e.g., \'Helvetica Neue\', \'Gotham\').']
  source_system text [note: 'The system or platform from which this brand guideline was sourced (e.g., \'Client Brand Portal\', \'Workfront DAM\', \'Adobe Creative Cloud\').']
  tone_of_voice text [note: 'Defined brand voice and tone characteristics for written communications (e.g., \'friendly and approachable\', \'authoritative and professional\').']
  typography_rules text [note: 'Detailed rules governing typography usage including font weights, sizes, line spacing, letter spacing, and hierarchy. Stored as structured text or JSON.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table creative.concept [note: 'Represents a creative concept or big idea developed in response to a creative brief. Captures concept title, creative territory, strategic rationale, mood board references, headline, tagline, visual direction, and approval status. A single brief may spawn multiple competing concepts; this entity tracks each concept through internal review and client presentation stages. Integrates with Workfront creative project milestones.'] {
  concept_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the creative concept. Primary key.']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Creative concepts are developed for a specific brand. Brand-level concept portfolio reporting, brand guideline compliance validation, and brand-level creative strategy reviews all require knowing whic [→ crm_db.client.brand (not enforced)]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Concepts are strategic outputs within initiatives. Linking enables ideation-to-execution traceability, concept testing tracking, and strategic alignment validation. Critical for creative development p [→ project.initiative]']
  milestone_id uuid [note: 'Foreign key linking to project.milestone. Business justification: Concept presentations and approvals are formal project milestones in advertising (e.g., \'Concept Approval Gate\'). Linking concept to project_milestone enables milestone-based concept approval tracking [→ project.milestone]']
  parent_concept_id uuid [note: 'Reference to the parent concept if this is a revision or variation. Enables tracking of concept evolution and iteration history. [→ creative.concept]']
  project_brief_id uuid [note: 'Foreign key linking to project.project_brief. Business justification: Concept development is directly scoped by the project brief in advertising. Agencies track which concepts respond to which project brief for brief-compliance review and concept evaluation. concept→cre [→ project.project_brief]']
  target_persona_id uuid [note: 'Foreign key linking to audience.persona. Business justification: Concepts are developed against persona profiles; creative strategy workshops and concept testing require linking concepts to target personas to validate strategic fit and ensure messaging resonates wi [→ cdp_db.audience.persona (not enforced)]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: Concept development is a discrete work package in advertising project plans (e.g., \'Concepting WP\'). Linking concept to work_package enables project managers to track planned vs. actual effort for con [→ project.work_package]']
  approval_date date [note: 'The date when the concept received final approval to proceed to production. Marks the transition from concept to execution phase.']
  approval_status text [note: 'Specific approval state indicating whether the concept has been approved by internal stakeholders and/or client. Tracks formal sign-off milestones. [→ ref.approval_status]']
  brand_compliance_flag boolean [not null, default: false, note: 'Indicates whether the concept has been reviewed and confirmed to comply with brand guidelines and standards. True if compliant, false if non-compliant or not yet reviewed.']
  channel_applicability text [note: 'Description of which media channels and platforms this concept is designed for or can be adapted to (e.g., TV, digital, OOH, social, print).']
  competitive_differentiation text [note: 'Description of how this concept differentiates the brand from competitors. Explains the unique positioning and competitive advantage.']
  concept_code text [not null, note: 'Unique business identifier or code assigned to the concept for tracking and reference across systems. Often used in project management and DAM systems.']
  concept_description text [note: 'Detailed narrative description of the creative concept. Explains the big idea, execution approach, and how the concept will come to life across touchpoints.']
  concept_status text [not null, note: 'Current lifecycle status of the concept. Tracks progression through internal review, client presentation, and approval stages. [→ ref.concept_status]']
  creative_territory text [note: 'The overarching creative theme, space, or territory that this concept occupies. Defines the broad strategic positioning and thematic direction.']
  estimated_production_cost numeric(15,2) [note: 'Estimated cost to produce and execute this concept if approved. Used for budget planning and concept selection decisions. [estimated_production_cost >= 0]']
  headline text [note: 'The primary headline or main message of the concept. The key communication element that captures attention and conveys the core idea.']
  key_message text [note: 'The core message or takeaway that the concept aims to communicate to the target audience. The single most important thing the audience should remember.']
  legal_review_required boolean [not null, default: false, note: 'Indicates whether this concept requires legal review before approval. True if legal clearance is needed, false otherwise.']
  legal_review_status text [note: 'Status of legal review process for this concept. Tracks whether legal has cleared the concept for use in advertising. [legal_review_status IN (\'not_required\', \'pending\', \'approved\', \'rejected\', \'conditional\')]']
  mood_board_reference text [note: 'Reference to mood board assets or inspiration materials that illustrate the visual and emotional tone of the concept. May include links to DAM assets or external references.']
  presentation_date date [note: 'The date when this concept was or will be presented to the client or internal stakeholders for review and feedback.']
  production_complexity text [note: 'Assessment of the production complexity and resource requirements for this concept. Influences feasibility and timeline planning. [production_complexity IN (\'low\', \'medium\', \'high\', \'very_high\')]']
  rejection_reason text [note: 'Explanation or feedback provided when a concept is rejected. Captures stakeholder concerns and rationale for non-approval.']
  strategic_rationale text [note: 'The strategic reasoning and business justification for this concept. Explains how the concept addresses the brief objectives and target audience insights.']
  tagline text [note: 'The tagline or supporting message that reinforces the concept. Often used as a memorable phrase that encapsulates the brand promise or campaign theme.']
  target_audience text [note: 'Description of the primary target audience this concept is designed to reach and resonate with. May reference audience segments or personas.']
  testing_recommendation text [note: 'Recommendation for whether and how this concept should be tested with target audiences before full production (e.g., focus groups, A/B testing, concept testing).']
  title text [not null, note: 'The working title or name of the creative concept. Used to identify and reference the concept throughout the development lifecycle.']
  tone_of_voice text [note: 'The communication style and personality of the concept. Describes how the brand should sound when expressing this idea (e.g., playful, authoritative, empathetic).']
  version integer [note: 'Version number of this concept iteration. Increments when significant revisions are made based on feedback.']
  visual_direction text [note: 'Description of the visual style, aesthetic, and design direction for the concept. Includes guidance on imagery, color palette, typography, and overall look and feel.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (concept_code) [unique]
  }
}

Table creative.creative_brief [note: 'Master record for the creative brief — the foundational document that initiates creative development. Captures client objectives, target audience, key messaging, tone of voice, deliverable formats, mandatories, budget envelope, and approval chain. Serves as the SSOT for all creative work initiated within a campaign or project. Originates from Workfront project intake and links to campaign strategy.'] {
  creative_brief_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the creative brief record. Primary key.']
  agency_relationship_id uuid [note: 'Foreign key linking to client.agency_relationship. Business justification: Creative briefs are issued within a specific agency relationship (AOR or project engagement). Agency billing, scope-of-services compliance, and fee reconciliation all require knowing which agency rela [→ crm_db.client.agency_relationship (not enforced)]']
  agreement_id uuid [note: 'Foreign key linking to contract.agreement. Business justification: Briefs execute under master service agreements (MSAs) that define scope, pricing, and deliverables. Agencies track which agreement governs each brief for billing validation, scope compliance, and cont [→ crm_db.contract.agreement (not enforced)]']
  brand_guideline_id uuid [note: 'Foreign key linking to creative.brand_guideline. Business justification: creative_brief currently stores brand guideline information as a free-text STRING column `brand_guidelines_reference`. This should be normalized to a proper FK to brand_guideline, which is the authori [→ creative.brand_guideline]']
  brand_id uuid [not null, note: 'Reference to the specific client brand for which this creative is being developed. [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [not null, note: 'Reference to the parent campaign that this creative brief supports. Links the brief to the broader campaign strategy. [→ media_ops_db.campaign.campaign (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Creative briefs are initiated by departments/practice groups tracked as cost centers for budget ownership and chargeback accounting. Agency finance teams allocate brief costs to originating cost cente [→ erp_db.finance.cost_center (not enforced)]']
  finance_budget_id uuid [note: 'Foreign key linking to finance.finance_budget. Business justification: Briefs reference approved budgets for scope and cost constraints. Links brief requirements to formal budget allocations for financial planning, approval workflows, and spend tracking against allocated [→ erp_db.finance.finance_budget (not enforced)]']
  initiative_id uuid [note: 'Reference to the Workfront project that initiated this creative brief. Links to project intake and resource planning. [→ project.initiative]']
  project_brief_id uuid [note: 'Foreign key linking to project.project_brief. Business justification: Creative briefs are execution-level briefs derived from project briefs. Linking enables strategic alignment validation, requirements traceability, scope verification, and brief-to-execution tracking. [→ project.project_brief]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Briefs are scoped and budgeted within specific SOWs. Agencies track this to ensure creative work stays within contracted scope, allocate costs to correct SOW line items, and validate budget availabili [→ crm_db.contract.sow (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Creative briefs specify preferred production vendors (studios, post-production houses, animation vendors) for execution. Essential for production planning, vendor assignment workflows, and budget allo [→ media_ops_db.vendor.supplier (not enforced)]']
  target_persona_id uuid [note: 'Foreign key linking to audience.persona. Business justification: Briefs define creative strategy against structured personas; target_audience_description is prose, but campaigns require linking to defined persona profiles for consistent targeting and measurement ac [→ cdp_db.audience.persona (not enforced)]']
  approved_by_name text [note: 'Name of the individual who provided final approval for the creative brief.']
  approved_date date [note: 'Date when the creative brief received final approval and was authorized to proceed to production.']
  art_director_assigned text [note: 'Name of the art director assigned to develop visual concepts and design for this creative brief.']
  brief_name text [not null, note: 'Descriptive name or title of the creative brief, typically reflecting the campaign or project name.']
  brief_number text [not null, note: 'Human-readable business identifier for the creative brief, typically following format CB-NNNNNN. Used for external communication and tracking. [brief_number ~ \'^CB-[0-9]{6,10}$\']']
  brief_type text [note: 'Classification of the creative brief based on its strategic purpose and scope. [brief_type IN (\'campaign\', \'tactical\', \'evergreen\', \'seasonal\', \'product_launch\', \'rebranding\')]']
  business_objective text [note: 'High-level business goal that this creative work is intended to achieve, such as brand awareness, lead generation, or product launch support.']
  call_to_action text [note: 'Desired audience action or response that the creative should drive, such as visit website, call now, or download app.']
  channel_distribution text [note: 'Media channels and platforms where the creative assets will be deployed, such as television, digital display, social media, OOH (Out-of-Home), or print.']
  competitive_context text [note: 'Analysis of competitive landscape and positioning considerations that should inform the creative approach.']
  copywriter_assigned text [note: 'Name of the copywriter assigned to develop written content for this creative brief.']
  creative_brief_status text [not null, note: 'Current lifecycle status of the creative brief in the approval and production workflow. [creative_brief_status IN (\'draft\', \'submitted\', \'approved\', \'in_production\', \'completed\', \'cancelled\')]']
  creative_director_assigned text [note: 'Name of the creative director assigned to oversee and approve the creative development for this brief.']
  deliverable_formats text [note: 'List of required creative asset formats and specifications, such as video lengths, display ad dimensions, print sizes, or social media formats.']
  due_date date [note: 'Target date by which the creative assets must be completed and delivered, driving production scheduling and resource allocation.']
  key_message text [note: 'Primary message or value proposition that the creative must communicate to the target audience.']
  legal_regulatory_requirements text [note: 'Specific legal disclaimers, regulatory compliance requirements, or industry standards that must be adhered to in the creative execution.']
  mandatories text [note: 'Required elements that must be included in the creative execution, such as logos, legal disclaimers, regulatory statements, or specific product features.']
  notes text [note: 'Additional notes, comments, or context that provide supplementary information for the creative team.']
  priority text [note: 'Business priority level assigned to this creative brief, influencing resource allocation and scheduling. [priority IN (\'low\', \'medium\', \'high\', \'urgent\')]']
  submitted_date date [note: 'Date when the creative brief was formally submitted for review and approval.']
  success_metrics text [note: 'Key Performance Indicators (KPI) and measurement criteria that will be used to evaluate the effectiveness of the creative execution.']
  supporting_messages text [note: 'Secondary messages or proof points that reinforce the key message and provide additional context.']
  target_audience_description text [note: 'Detailed description of the intended audience for the creative, including demographic, psychographic, and behavioral characteristics.']
  tone_of_voice text [note: 'Desired communication style and personality for the creative execution, such as professional, playful, authoritative, or empathetic.']
  version_number integer [note: 'Version number of the creative brief, incremented with each revision or update to track changes over time.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (brief_number) [unique]
  }
}

Table creative.spec [note: 'Reference entity defining the technical and creative specifications for a deliverable format — including ad unit dimensions, file format, max file size, safe zones, bleed, color mode, frame rate, bit rate, audio specs, and platform-specific requirements (IAB standard units, Google CM360 specs, Meta ad specs, OOH print specs). Versioned to track spec changes as platforms update requirements (e.g., Meta quarterly spec updates, IAB new format releases). Acts as the specification template against which assets are validated for format compliance before trafficking. Maintained by the creative technology team with platform update monitoring.'] {
  spec_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the creative specification record. Primary key.']
  ad_format_id uuid [note: 'Foreign key linking to media.ad_format. Business justification: Creative specs are defined to meet media ad format requirements (IAB standard units, dimensions, file constraints). Linking spec to ad_format enables cross-domain trafficking compatibility reporting, [→ media_ops_db.media.ad_format (not enforced)]']
  publisher_id uuid [note: 'Foreign key linking to vendor.publisher. Business justification: Ad ops spec management: creative specs are publisher-specific, defining acceptable formats, file sizes, and technical requirements per publisher inventory. Ad ops teams build and maintain spec librari [→ media_ops_db.vendor.publisher (not enforced)]']
  ad_unit_type text [note: 'The type of ad unit (e.g., Banner, Interstitial, Video, Native, Story, Carousel, Sponsored Post, Billboard, Transit Shelter).']
  animation_loop_allowed boolean [not null, default: false, note: 'Indicates whether animated creatives (GIF, HTML5) are allowed to loop continuously (True) or must play once (False).']
  aspect_ratio text [note: 'The aspect ratio of the creative (e.g., 16:9, 9:16, 1:1, 4:5). Used for video and image formats.']
  audio_channels text [note: 'The required audio channel configuration (mono, stereo, surround). Null for non-audio formats. [audio_channels IN (\'mono\', \'stereo\', \'surround\')]']
  audio_codec text [note: 'The required audio codec for video or audio creatives (e.g., AAC, MP3, Vorbis). Null for non-audio formats.']
  audio_sample_rate_hz integer [note: 'The required audio sample rate in Hertz (e.g., 44100, 48000). Null for non-audio formats.']
  bit_rate_kbps integer [note: 'The required or recommended bit rate for video or audio creatives in kilobits per second (Kbps). Null for non-media formats.']
  bleed_pixels integer [note: 'The bleed area in pixels extending beyond the trim edge for print creatives to ensure no white edges after cutting.']
  brand_safety_level text [note: 'The brand safety level required for creatives using this specification (standard, moderate, strict). Determines content restrictions and placement guidelines. [brand_safety_level IN (\'standard\', \'moderate\', \'strict\')]']
  clickable_required boolean [not null, default: false, note: 'Indicates whether the creative must include a clickable call-to-action or link (True) or can be non-interactive (False).']
  color_mode text [note: 'The required color mode for the creative (RGB for digital, CMYK for print, Grayscale, Pantone for brand-specific print). [color_mode IN (\'rgb\', \'cmyk\', \'grayscale\', \'pantone\')]']
  color_profile text [note: 'The ICC color profile required for the creative (e.g., sRGB, Adobe RGB, CMYK US Web Coated SWOP v2).']
  compliance_tags text [note: 'Comma-separated list of compliance or regulatory tags applicable to this specification (e.g., \'GDPR\', \'COPPA\', \'Alcohol Restricted\', \'Pharma Compliant\').']
  effective_date date [note: 'The date from which this specification version becomes effective and should be used for new creative production.']
  expiration_date date [note: 'The date after which this specification version is no longer valid and should not be used for new creative production. Null for specifications without expiration.']
  file_format text [note: 'The required file format for the creative asset (e.g., JPG, PNG, GIF, MP4, MOV, WEBM, MP3, WAV, HTML5, PDF, EPS, AI, PSD). [→ ref.file_format]']
  format_category text [note: 'High-level category of the creative format (static image, animated image, video, audio, HTML5, rich media, native, interactive, print, physical). [→ ref.format_category]']
  frame_rate_fps integer [note: 'The required or recommended frame rate for video creatives in frames per second (e.g., 24, 30, 60). Null for non-video formats.']
  height_pixels integer [note: 'The height dimension of the ad unit in pixels. Null for non-digital formats.']
  iab_standard_unit text [note: 'The IAB standard ad unit designation if this specification conforms to an IAB standard (e.g., \'Medium Rectangle\', \'Leaderboard\', \'Skyscraper\').']
  max_animation_loops integer [note: 'The maximum number of times an animated creative is allowed to loop. Null if unlimited or not applicable.']
  max_duration_seconds numeric(10,2) [note: 'The maximum duration for video or audio creatives in seconds. Null for non-time-based formats. [max_duration_seconds >= 0]']
  max_file_size_kb integer [note: 'The maximum allowed file size for the creative asset in kilobytes (KB). [max_file_size_kb >= 0]']
  min_duration_seconds numeric(10,2) [note: 'The minimum duration for video or audio creatives in seconds. Null for non-time-based formats. [min_duration_seconds >= 0]']
  notes text [note: 'Additional notes, guidelines, or special instructions for creative teams regarding this specification (e.g., platform-specific quirks, best practices, known issues).']
  platform text [note: 'The advertising platform or channel for which this specification applies (e.g., Google CM360, Meta, TikTok, LinkedIn, OOH Print, DOOH Digital, CTV, OTT). [→ ref.platform]']
  platform_spec_version text [note: 'The version of the platform-specific specification this record is based on (e.g., \'Meta Q1 2024\', \'Google CM360 v3.2\'). Used to track spec changes as platforms update requirements.']
  resolution_dpi integer [note: 'The required resolution for print or high-resolution digital creatives in dots per inch (DPI). Typically 300 DPI for print, 72 DPI for web.']
  safe_zone_pixels integer [note: 'The safe zone margin in pixels where critical content (text, logos) must remain to avoid being cut off during display or printing.']
  spec_code text [not null, note: 'Unique business identifier code for the specification, used for system integration and asset validation workflows.']
  spec_name text [not null, note: 'Human-readable name for the creative specification (e.g., \'Facebook Feed Image Standard\', \'Google Display 300x250\', \'Instagram Story Video\').']
  spec_status text [not null, note: 'Current lifecycle status of the creative specification (active, deprecated, draft, archived, pending approval, retired). [spec_status IN (\'active\', \'deprecated\', \'draft\', \'archived\', \'pending_approval\', \'retired\')]']
  transparency_allowed boolean [not null, default: false, note: 'Indicates whether the creative format supports transparency (alpha channel) in images (True) or requires opaque backgrounds (False).']
  video_codec text [note: 'The required video codec for video creatives (e.g., H.264, H.265, VP9). Null for non-video formats.']
  width_pixels integer [note: 'The width dimension of the ad unit in pixels. Null for non-digital formats.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (spec_code) [unique]
  }
}

Table creative.asset [note: 'Core master entity representing a single creative asset in the Digital Asset Management system — including images, videos, audio files, copy documents, design files (PSD, AI, INDD), motion graphics, HTML5 rich media, and 3D/AR assets. Tracks asset type, format, file size, resolution, duration, codec, color profile, aspect ratio, DAM asset ID (Workfront DAM/Adobe AEM), version lineage, brand compliance status, rights clearance status, lifecycle stage (WIP, in-review, approved, archived, expired), expiry date, and descriptive metadata tags (subject, mood, channel, campaign theme). This is the SSOT for all creative asset metadata and taxonomy across the agency, supporting search, retrieval, reuse discovery, and rights monitoring.'] {
  asset_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the creative asset in the Digital Asset Management (DAM) system. Primary key.']
  advertiser_id uuid [note: 'FK to client.advertiser.advertiser_id — MUST-HAVE: Cannot determine asset ownership. Required for rights management, brand compliance, and client asset libraries. [→ crm_db.client.advertiser (not enforced)]']
  brand_id uuid [note: 'Reference to the client brand that owns or is represented by this asset. Enables brand-level asset organization and reporting. [→ crm_db.client.brand (not enforced)]']
  creative_brief_id uuid [note: 'Foreign key linking to creative.creative_brief. Business justification: A creative asset is produced in direct response to a creative brief — the brief defines the key message, tone, mandatories, deliverable formats, and brand direction that govern the asset. Adding creat [→ creative.creative_brief]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Assets are deliverables within initiatives. Linking enables asset inventory management, reuse tracking across projects, ROI analysis, and portfolio reporting. Essential for digital asset management an [→ project.initiative]']
  parent_asset_creative_asset_id uuid [note: 'Reference to the parent or original asset from which this version was derived. Establishes version lineage and asset family relationships. [→ creative.asset]']
  persona_id uuid [note: 'Foreign key linking to audience.persona. Business justification: Dynamic Creative Optimization (DCO) and personalization workflows require assets to be mapped to specific personas. Creative performance reporting by persona (e.g., \'which assets performed best for th [→ cdp_db.audience.persona (not enforced)]']
  production_job_id uuid [note: 'Foreign key linking to creative.production_job. Business justification: A creative asset is the output artifact of a production job. Linking creative_asset to the production_job that produced it provides operational traceability — enabling job-level asset inventory, cost [→ creative.production_job]']
  segment_id uuid [note: 'Foreign key linking to audience.segment. Business justification: Assets are optimized for specific audience segments; personalization and dynamic creative optimization require segment-level asset assignment to deliver relevant creative to each audience, core to mod [→ cdp_db.audience.segment (not enforced)]']
  spec_id uuid [note: 'Foreign key linking to creative.spec. Business justification: Creative assets are produced to meet specific creative specifications (format, dimensions, file size, codec, etc.). This link tracks which spec an asset was produced to, supporting validation and comp [→ creative.spec]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Assets created by external vendors (stock media providers, production companies, freelance studios) require vendor attribution for rights management, usage tracking, invoice reconciliation, and qualit [→ media_ops_db.vendor.supplier (not enforced)]']
  task_id uuid [note: 'Foreign key linking to project.task. Business justification: Assets are outputs of specific tasks. Linking enables granular effort tracking, resource utilization analysis, task completion validation, and productivity measurement. Essential for time tracking and [→ project.task]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: Creative assets are produced within specific work packages (e.g., \'Digital Asset Production WP\'). Direct work_package_id on creative_asset enables work-package-level asset inventory and cost reporting [→ project.work_package]']
  approved_timestamp timestamptz [note: 'Date and time when the asset was approved for use. Establishes the point at which the asset became available for trafficking and deployment.']
  archived_timestamp timestamptz [note: 'Date and time when the asset was archived or retired from active use. Supports lifecycle management and storage optimization.']
  aspect_ratio text [note: 'Proportional relationship between width and height (e.g., 16:9, 4:3, 1:1, 9:16). Determines display format and channel suitability.']
  asset_name text [not null, note: 'Human-readable name or title of the creative asset. Primary label used for search and identification.']
  asset_type text [not null, note: 'High-level classification of the creative asset format. Determines handling, rendering, and distribution workflows. [→ ref.asset_type]']
  brand_compliance_status text [note: 'Indicates whether the asset adheres to brand guidelines and standards. Critical for brand integrity and legal risk management. [brand_compliance_status IN (\'compliant\', \'non_compliant\', \'pending_review\', \'not_applicable\')]']
  campaign_theme text [note: 'Overarching creative theme or concept associated with the asset (e.g., Summer Sale, Back to School, Holiday 2024). Links asset to strategic messaging.']
  channel_suitability text [note: 'Comma-separated list of media channels for which this asset is optimized or approved (e.g., TV, Digital, OOH, Social, CTV). Guides media planning and trafficking.']
  codec text [note: 'Video or audio codec used for encoding (e.g., H.264, H.265, AAC, MP3). Critical for playback compatibility and quality.']
  color_profile text [note: 'Color space or profile used in the asset (e.g., sRGB, Adobe RGB, CMYK). Ensures color accuracy across media and devices.']
  copyright_holder text [note: 'Name of the individual or organization that holds copyright to the asset. Critical for legal compliance and rights management.']
  creative_asset_description text [note: 'Free-text description of the asset content, purpose, and usage notes. Provides context for search, reuse, and creative briefing.']
  dam_asset_ref text [not null, note: 'External unique identifier from the source DAM system (Workfront DAM or Adobe AEM). Used for cross-system reconciliation and asset retrieval.']
  duration_seconds numeric(10,2) [note: 'Length of the asset in seconds. Applicable to video, audio, and motion graphics assets. [duration_seconds >= 0]']
  file_format text [note: 'Specific file format or extension of the asset (e.g., PSD, AI, INDD, MP4, PNG, JPG, HTML5). Critical for compatibility and production workflows.']
  file_size_bytes bigint [note: 'Size of the asset file in bytes. Used for storage management, bandwidth planning, and delivery optimization. [file_size_bytes >= 0]']
  file_storage_path text [note: 'Full path or URI to the asset file in the storage system (cloud storage, DAM repository, CDN). Used for retrieval and delivery.']
  geographic_market text [note: 'Target geographic market or region for which the asset was created (e.g., USA, GBR, CAN). Supports regional campaign management and compliance.']
  is_master_asset boolean [not null, default: false, note: 'Flag indicating whether this asset is the master or source-of-truth version from which other versions are derived. True for master assets, false for derivatives.']
  language_code text [note: 'ISO 639-1 two-letter language code indicating the primary language of the asset (e.g., EN, ES, FR). Critical for localization and regional targeting.']
  license_type text [note: 'Type of license under which the asset is used (e.g., royalty-free, rights-managed, exclusive, non-exclusive). Governs usage terms and restrictions.']
  lifecycle_stage text [note: 'Current stage in the creative asset lifecycle. Governs access, usage rights, and workflow routing. [lifecycle_stage IN (\'wip\', \'in_review\', \'approved\', \'published\', \'archived\', \'expired\')]']
  mood_tags text [note: 'Comma-separated keywords describing the emotional tone or mood of the asset (e.g., energetic, calm, humorous, inspirational). Aids in creative selection and reuse.']
  resolution text [note: 'Pixel dimensions or resolution of the asset (e.g., 1920x1080, 300 DPI). Applicable to images and videos.']
  rights_clearance_status text [note: 'Status of legal rights and usage permissions for the asset (talent, music, stock imagery, etc.). Determines where and how the asset can be used. [rights_clearance_status IN (\'cleared\', \'pending\', \'restricted\', \'expired\')]']
  rights_expiry_date date [note: 'Date when usage rights for the asset expire. After this date, the asset may no longer be legally used without renewal.']
  subject_tags text [note: 'Comma-separated descriptive keywords describing the subject matter or content of the asset (e.g., product, lifestyle, testimonial). Supports search and discovery.']
  thumbnail_url text [note: 'URL to a thumbnail or preview image of the asset. Enables quick visual identification in DAM interfaces and reporting tools.']
  usage_count integer [note: 'Number of times this asset has been used in campaigns, ads, or other placements. Indicates asset popularity and reuse value. [usage_count >= 0]']
  version_number text [note: 'Version identifier for the asset (e.g., v1.0, v2.3, final). Tracks iteration and revision history.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (dam_asset_ref) [unique]
  }
}

Table creative.asset_version [note: 'Tracks the full version history of a creative asset — capturing each iteration produced during the creative development lifecycle. Records version number, version label (e.g., v1, v2_client_feedback), file reference, change summary, author, Adobe CC document version ID, Workfront proof version ID, and promotion status (draft, in-review, approved, superseded). Enables rollback, audit, and compliance traceability for all creative deliverables.'] {
  asset_version_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the asset version record. Primary key.']
  asset_id uuid [not null, note: 'Reference to the parent creative asset for which this version was created. [→ creative.asset]']
  creative_deliverable_id uuid [note: 'Foreign key linking to creative.creative_deliverable. Business justification: Asset versions represent iterative development states of deliverables. Production tracking requires linking each version to its parent deliverable to manage revision history, track which version was a [→ creative.creative_deliverable]']
  deliverable_tracker_id uuid [note: 'Foreign key linking to project.deliverable_tracker. Business justification: Specific asset versions are submitted as deliverables and tracked in deliverable_tracker (which stores file_reference and version_number as plain text). A proper FK normalizes this and enables version [→ project.deliverable_tracker]']
  production_job_id uuid [note: 'Foreign key linking to creative.production_job. Business justification: Each asset version is produced within the context of a specific production job — revisions, re-renders, and format adaptations are all tracked as versions tied to the job that commissioned them. Addin [→ creative.production_job]']
  spec_id uuid [note: 'Foreign key linking to creative.spec. Business justification: Each asset version should track which creative specification it conforms to. As assets are revised through the version history, they may be adjusted to meet different specs or updated spec versions. T [→ creative.spec]']
  task_id uuid [note: 'Foreign key linking to project.task. Business justification: In advertising production, each asset version is created during a specific revision or QA task. Linking asset_version to task enables task-level version history reporting and effort-to-version traceab [→ project.task]']
  adobe_cc_document_version_ref text [note: 'External version identifier from Adobe Creative Cloud system. Enables traceability to source Adobe application (Photoshop, Illustrator, InDesign, Premiere Pro).']
  approval_timestamp timestamptz [note: 'Date and time when this version received formal approval. Null if not yet approved.']
  approved_by_name text [note: 'Name of the individual who approved this version for promotion or final delivery. Null if not yet approved.']
  archive_timestamp timestamptz [note: 'Date and time when this version was archived. Null if not yet archived.']
  brand_compliance_status text [note: 'Indicates whether this version adheres to brand guidelines and standards. Used for brand governance and quality control. [brand_compliance_status IN (\'compliant\', \'non_compliant\', \'pending_review\', \'not_applicable\')]']
  change_summary text [note: 'Brief description of changes made in this version compared to the previous iteration. Captures rationale for the revision.']
  checksum_hash text [note: 'Cryptographic hash (e.g., MD5, SHA-256) of the file for integrity verification and duplicate detection.']
  color_profile text [note: 'Color space or profile used in this version (e.g., sRGB, Adobe RGB, CMYK). Critical for print and digital color accuracy.']
  compliance_check_timestamp timestamptz [note: 'Date and time when brand compliance review was last performed on this version. Null if not yet reviewed.']
  duration_seconds numeric(10,2) [note: 'Duration of video or audio creative in seconds. Null for static assets. [duration_seconds >= 0]']
  file_format text [note: 'File format or extension of this version (e.g., PSD, AI, INDD, PDF, JPG, PNG, MP4, MOV). Indicates the Adobe Creative Cloud or export format. [→ ref.file_format]']
  file_name text [note: 'Original file name of this version as stored in the system.']
  file_path text [note: 'Storage location or URI reference to the physical file for this version in the Digital Asset Management (DAM) system or cloud storage.']
  file_size_bytes bigint [note: 'Size of the version file in bytes. Used for storage management and delivery optimization. [file_size_bytes >= 0]']
  height_pixels integer [note: 'Height dimension of the creative asset in pixels. Applicable to image and video formats.']
  is_archived boolean [not null, default: false, note: 'Indicates whether this version has been archived and moved to long-term storage. True if archived, False if active.']
  is_promoted boolean [not null, default: false, note: 'Indicates whether this version has been promoted to production or final delivery status. True if promoted, False otherwise.']
  promotion_timestamp timestamptz [note: 'Date and time when this version was promoted to production or approved for final delivery. Null if not yet promoted.']
  rejection_reason text [note: 'Explanation or rationale for rejection if this version was not approved. Null if approved or pending.']
  resolution_dpi integer [note: 'Resolution of the asset in dots per inch. Typically 72 for digital, 300+ for print. Null for video assets.']
  version_label text [note: 'Human-readable version label or tag (e.g., v1, v2_client_feedback, v3_final, draft_A). Used for identification and communication.']
  version_number integer [not null, note: 'Sequential numeric version number indicating the iteration sequence (1, 2, 3, etc.).']
  version_status text [not null, note: 'Current lifecycle status of this version. Tracks progression through creative approval workflow. [version_status IN (\'draft\', \'in_review\', \'approved\', \'rejected\', \'superseded\', \'archived\')]']
  width_pixels integer [note: 'Width dimension of the creative asset in pixels. Applicable to image and video formats.']
  workfront_proof_version_ref text [note: 'External proof version identifier from Workfront proofing system. Links to approval and feedback workflow.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table creative.creative_deliverable [note: 'Represents a specific creative deliverable committed to a client or campaign — a named output (e.g., \'30s TV spot :30\', \'MPU 300x250 HTML5 banner\', \'Full-page print ad\') with defined format, channel, quantity, and delivery deadline. Links the creative brief requirement to the production job and final approved asset. Tracks deliverable status (not-started, in-production, delivered, accepted) and client acceptance sign-off. Serves as the contractual unit of creative output.'] {
  creative_deliverable_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the creative deliverable. Primary key.']
  ad_format_id uuid [note: 'Foreign key linking to media.ad_format. Business justification: Creative deliverables are produced for specific ad formats defined in the media plan. Linking deliverables to the media ad_format taxonomy enables trafficking teams to validate format compliance, supp [→ media_ops_db.media.ad_format (not enforced)]']
  advertiser_id uuid [note: 'Reference to the advertiser client for whom this deliverable is being produced. [→ crm_db.client.advertiser (not enforced)]']
  asset_id uuid [note: 'Foreign key linking to creative.asset. Business justification: A deliverable is fulfilled by a creative asset (the actual digital file in the DAM). The creative_deliverable table currently has dam_asset_id as a STRING, which should be normalized to a proper FK to [→ creative.asset]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Creative deliverables are brand-specific assets. Brand compliance status tracking, brand-level delivery reporting, and brand guideline adherence checks on deliverables all require a direct brand FK. c [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [note: 'Reference to the campaign this deliverable supports. [→ media_ops_db.campaign.campaign (not enforced)]']
  contract_deliverable_id uuid [note: 'Foreign key linking to contract.contract_deliverable. Business justification: Contract deliverables define what must be produced per agreement; creative_deliverable tracks actual creative execution. Linking these enables acceptance tracking, milestone completion validation, bil [→ crm_db.contract.contract_deliverable (not enforced)]']
  contract_insertion_order_id uuid [note: 'Foreign key linking to contract.contract_insertion_order. Business justification: Creative deliverables fulfill specific contract insertion orders — the IO specifies placement, format, and flight that the deliverable must satisfy for trafficking. Named process: \'deliverable fulfill [→ crm_db.contract.contract_insertion_order (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Deliverables are produced by specific departments/studios tracked as cost centers. Enables cost allocation, departmental utilization reporting, and chargeback accounting for deliverable production cos [→ erp_db.finance.cost_center (not enforced)]']
  creative_brief_id uuid [note: 'Reference to the creative brief that defines the requirements for this deliverable. [→ creative.creative_brief]']
  deliverable_tracker_id uuid [note: 'Foreign key linking to project.deliverable_tracker. Business justification: The creative_deliverable (creative domain record) must reconcile with the deliverable_tracker (project domain record) for unified delivery status reporting. Advertising agencies track deliverables in [→ project.deliverable_tracker]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Deliverables are outputs of initiatives. Linking enables scope validation, milestone tracking, client reporting, and deliverable inventory management across the initiative lifecycle. Critical for proj [→ project.initiative]']
  media_placement_id uuid [note: 'Foreign key linking to media.media_placement. Business justification: Creative deliverables are produced for specific media placements. Trafficking teams must know which deliverable is assigned to which placement to execute ad serving. This placement-to-deliverable assi [→ media_ops_db.media.media_placement (not enforced)]']
  milestone_id uuid [note: 'Foreign key linking to project.milestone. Business justification: Deliverables are tied to contractual milestones. Linking enables billing trigger validation, client acceptance tracking, payment release management, and SOW compliance verification. Essential for reve [→ project.milestone]']
  persona_id uuid [note: 'Foreign key linking to audience.persona. Business justification: Persona-based creative strategy requires deliverables to be assigned to specific personas (e.g., \'produce a 30s video for the Urban Millennial persona\'). Persona-level deliverable tracking drives pers [→ cdp_db.audience.persona (not enforced)]']
  plan_id uuid [note: 'Foreign key linking to media.plan. Business justification: Deliverables are produced to fulfill media plan requirements. Creative teams need to know which plan drives each deliverable to ensure formats, specs, and deadlines align with media flight dates and c [→ media_ops_db.media.plan (not enforced)]']
  production_job_id uuid [note: 'Foreign key linking to creative.production_job. Business justification: A creative deliverable is the output produced by a production job. This is a direct operational relationship: the production job is the unit of work that creates the deliverable. Cardinality: N:1 (one [→ creative.production_job]']
  project_budget_id uuid [note: 'Foreign key linking to project.project_budget. Business justification: Deliverables have budget allocations. Linking enables cost-to-deliver tracking, profitability analysis, budget forecasting, and financial reporting. Critical for project financial management and prici [→ project.project_budget]']
  rate_card_line_id uuid [note: 'Foreign key linking to contract.rate_card_line. Business justification: Creative deliverables are billed at rates defined by contract rate card lines (e.g., per-asset production fee, per-format creative rate). Linking deliverable to rate_card_line enables accurate billing [→ crm_db.contract.rate_card_line (not enforced)]']
  segment_id uuid [note: 'Foreign key linking to audience.segment. Business justification: Deliverables are tailored to audience segments; trafficking workflows and media plan execution require segment-level creative mapping to ensure correct creative serves to each audience, essential for [→ cdp_db.audience.segment (not enforced)]']
  sla_id uuid [note: 'Foreign key linking to contract.sla. Business justification: Creative deliverables are subject to contracted SLA terms governing turnaround times, revision cycles, and delivery standards. Agencies track SLA compliance per deliverable for performance reporting a [→ crm_db.contract.sla (not enforced)]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Creative deliverables fulfill contractual obligations defined in SOWs. Tracking this link enables acceptance criteria validation, milestone-based invoicing, client sign-off workflows, and ensures deli [→ crm_db.contract.sow (not enforced)]']
  spec_id uuid [note: 'Foreign key linking to creative.spec. Business justification: Deliverables must conform to creative specifications (platform requirements, format constraints, technical specs). The creative_deliverable table has format_specification as a STRING, which should be [→ creative.spec]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Deliverables produced by external vendors need vendor tracking for invoice reconciliation, quality management, SLA monitoring, and vendor performance evaluation. Essential for production operations an [→ media_ops_db.vendor.supplier (not enforced)]']
  task_id uuid [note: 'Foreign key linking to project.task. Business justification: Creative deliverables are produced by specific project tasks (e.g., \'Copywriting Task\', \'Design Task\'). Linking creative_deliverable to task enables task-level deliverable attribution, effort-to-deliv [→ project.task]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: Deliverables map to specific work packages in WBS. Linking enables granular schedule tracking, resource allocation, earned value management, and deliverable-level progress reporting. Essential for pro [→ project.work_package]']
  accepted_date date [note: 'Date when the client formally accepted the deliverable and signed off on completion.']
  actual_cost numeric(15,2) [note: 'Actual total production cost incurred for this deliverable, used for financial reconciliation and profitability analysis. [actual_cost >= 0]']
  actual_hours numeric(10,2) [note: 'Actual number of labor hours spent producing this deliverable, tracked for billing and performance analysis. [actual_hours >= 0]']
  assigned_copywriter text [note: 'Name of the copywriter assigned to develop copy and messaging for this deliverable.']
  assigned_creative_team text [note: 'Name or identifier of the creative team or studio responsible for producing this deliverable.']
  brand_compliance_status text [note: 'Indicates whether the deliverable meets brand guideline requirements and has passed brand compliance review. [brand_compliance_status IN (\'compliant\', \'non_compliant\', \'pending_review\', \'not_applicable\')]']
  channel text [note: 'Media channel where the deliverable will be deployed. [→ ref.channel]']
  currency_code char(3) [note: 'Three-letter ISO 4217 currency code for cost and billing amounts (e.g., USD, EUR, GBP). [currency_code ~ \'^[A-Z]{3}$\']']
  deliverable_code text [not null, note: 'Unique business identifier or tracking code for the deliverable used across systems (e.g., \'SUMR-2024-TV-30S-001\').']
  deliverable_name text [not null, note: 'Human-readable name of the creative deliverable (e.g., \'30s TV Spot - Summer Campaign\', \'MPU 300x250 HTML5 Banner\').']
  deliverable_status text [not null, note: 'Current lifecycle status of the creative deliverable in the production and approval workflow. [→ ref.deliverable_status]']
  deliverable_type text [note: 'Category of creative deliverable based on media format and channel. [→ ref.deliverable_type]']
  delivered_date date [note: 'Date when the deliverable was delivered to the client or uploaded to the delivery platform.']
  delivery_method text [note: 'Method by which the deliverable was or will be delivered to the client or trafficking system. [delivery_method IN (\'email\', \'ftp\', \'cloud_storage\', \'dam_portal\', \'physical_media\', \'api\')]']
  dimensions text [note: 'Physical or pixel dimensions of the deliverable (e.g., \'300x250\', \'1920x1080\', \'8.5x11 inches\').']
  due_date date [note: 'Contractual deadline by which the deliverable must be completed and delivered to the client.']
  duration_seconds integer [note: 'Duration of the creative deliverable in seconds, applicable to video and audio formats (e.g., 15, 30, 60). [duration_seconds >= 0]']
  estimated_cost numeric(15,2) [note: 'Estimated total production cost for this deliverable including labor, materials, and third-party services. [estimated_cost >= 0]']
  estimated_hours numeric(10,2) [note: 'Estimated number of labor hours required to complete this deliverable, used for resource planning and costing. [estimated_hours >= 0]']
  file_format text [note: 'File format of the final deliverable asset (e.g., MP4, HTML5, PDF, JPEG). [→ ref.file_format]']
  file_size_mb numeric(10,2) [note: 'Size of the final deliverable file in megabytes, used for storage planning and delivery validation. [file_size_mb >= 0]']
  legal_approval_required boolean [not null, default: false, note: 'Flag indicating whether this deliverable requires legal review and approval before delivery (e.g., for claims, disclaimers, regulatory compliance).']
  legal_approval_status text [note: 'Current status of legal review and approval for this deliverable. [legal_approval_status IN (\'not_required\', \'pending\', \'approved\', \'rejected\', \'conditional\')]']
  notes text [note: 'Free-text field for additional notes, special instructions, or context about the deliverable.']
  priority text [note: 'Business priority level assigned to this deliverable for resource allocation and scheduling. [priority IN (\'critical\', \'high\', \'medium\', \'low\')]']
  production_start_date date [note: 'Date when production work on this deliverable began.']
  quantity_required integer [note: 'Number of units or versions of this deliverable required (e.g., 3 language versions, 5 size variations). [quantity_required >= 0]']
  requested_date date [note: 'Date when the deliverable was originally requested by the client or account team.']
  revision_count integer [note: 'Number of revision cycles this deliverable has undergone since initial submission. [revision_count >= 0]']
  version_number text [note: 'Version identifier for the deliverable to track iterations and revisions (e.g., \'v1.0\', \'v2.3\', \'Final\').']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (deliverable_code) [unique]
  }
}

Table creative.production_job [note: 'Operational record representing a discrete creative production job — the unit of work assigned to an internal studio team, freelancer, or external production vendor to produce one or more creative deliverables. Tracks job type (print, digital, video, audio, OOH, DOOH, CTV, social, experiential), job status (briefed, in-production, internal-review, QA, client-review, delivered), assigned studio or production house, estimated and actual production hours, cost estimate vs actual cost, delivery deadline, and priority level. Links to creative brief requirements and spawns creative assets upon completion. Sourced from Workfront project tasks and integrates with SAP PS for cost tracking.'] {
  production_job_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the production job. Primary key.']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Production jobs are executed for a specific brand. Brand-level production cost reporting, brand compliance requirement enforcement, and brand-scoped production capacity planning all require this direc [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [note: 'Reference to the campaign this production job supports. [→ media_ops_db.campaign.campaign (not enforced)]']
  concept_id uuid [note: 'Foreign key linking to creative.concept. Business justification: Production jobs execute approved concepts. Once a concept is approved, production jobs are created to produce the creative deliverables. This direct link allows tracking which concept a production job [→ creative.concept]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Production jobs are core cost-tracking units in agency operations. Jobs are allocated to cost centers (studio, creative department) for labor cost accounting, overhead allocation, and departmental P&L [→ erp_db.finance.cost_center (not enforced)]']
  creative_brief_id uuid [note: 'Reference to the creative brief that initiated this production job. [→ creative.creative_brief]']
  delivery_project_milestone_id uuid [note: 'Foreign key linking to project.milestone. Business justification: Production job delivery deadlines align with contractual project milestones (e.g., \'Final Delivery\' milestone that triggers client billing). Role-prefix \'delivery_\' distinguishes this from other poten [→ project.milestone]']
  gl_account_id uuid [note: 'Foreign key linking to finance.gl_account. Business justification: Production job costs post directly to GL accounts in agency accounting (SAP/NetSuite). production_job already has sap_wbs_element indicating ERP integration; GL account assignment is required for cost [→ erp_db.finance.gl_account (not enforced)]']
  plan_id uuid [note: 'Foreign key linking to media.plan. Business justification: Production jobs are initiated to create deliverables for media plans. Studios need plan context for format specifications, channel requirements, flight deadlines, and ensuring creative is ready before [→ media_ops_db.media.plan (not enforced)]']
  primary_production_initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Production jobs are work execution units within initiatives. Linking enables project portfolio reporting, resource planning across initiatives, budget roll-ups, and timeline tracking. Essential for ag [→ project.initiative]']
  project_budget_id uuid [note: 'Foreign key linking to project.project_budget. Business justification: Production jobs consume project budgets. Linking enables cost tracking, variance analysis, budget utilization reporting, and profitability analysis. Essential for financial management and project cont [→ project.project_budget]']
  sla_id uuid [note: 'Foreign key linking to contract.sla. Business justification: Production jobs are subject to contracted SLA commitments covering delivery timelines and revision turnaround. Agencies track whether production jobs meet contracted SLA terms for performance reportin [→ crm_db.contract.sla (not enforced)]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Production jobs are delivered under SOW terms that define deliverables, timelines, and pricing. Agencies track which SOW governs each job for accurate billing, resource allocation, and contract compli [→ crm_db.contract.sow (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Production jobs are frequently outsourced to external studios, post-production facilities, VFX houses, and freelance production companies. Critical for vendor billing reconciliation, quality managemen [→ media_ops_db.vendor.supplier (not enforced)]']
  task_id uuid [note: 'Foreign key linking to project.task. Business justification: Production jobs in advertising are executed through specific project tasks (e.g., \'Studio Production Task\'). Linking production_job to task enables time-entry reconciliation against production jobs an [→ project.task]']
  vendor_rate_card_id uuid [note: 'Foreign key linking to vendor.vendor_rate_card. Business justification: Production cost management: when a supplier is engaged for a production job, the agreed vendor rate card governs billing, cost estimation, and reconciliation. Production managers and finance teams nee [→ media_ops_db.vendor.vendor_rate_card (not enforced)]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: Production jobs are work packages in project plans. Linking enables task-level tracking, capacity planning, WBS-based reporting, and resource utilization analysis. Critical for studio operations manag [→ project.work_package]']
  actual_cost numeric(15,2) [note: 'Actual total cost incurred for this production job, reconciled from time tracking, vendor invoices, and expense reports. [actual_cost >= 0]']
  actual_hours numeric(10,2) [note: 'Actual total production hours spent on this job, tracked for cost reconciliation and future estimation accuracy. [actual_hours >= 0]']
  assigned_studio text [note: 'Name of the internal studio team, freelancer, or external production vendor assigned to execute this job.']
  brand_compliance_required boolean [not null, default: false, note: 'Indicates whether this production job requires formal brand guideline compliance review and approval.']
  brand_compliance_status text [note: 'Status of brand compliance review for this job. Values: not-required (compliance not needed), pending (review in progress), passed (compliant), failed (non-compliant), waived (compliance waived by client). [brand_compliance_status IN (\'not-required\', \'pending\', \'passed\', \'failed\', \'waived\')]']
  client_approval_date date [note: 'Date when the client formally approved the final creative deliverables for this job.']
  client_feedback text [note: 'Feedback and comments received from the client during review cycles, captured for revision guidance and future reference.']
  currency_code char(3) [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this production job (e.g., USD, EUR, GBP). [currency_code ~ \'^[A-Z]{3}$\']']
  deliverable_count integer [note: 'Total number of distinct creative assets or deliverables produced as part of this production job. [deliverable_count >= 0]']
  delivery_deadline date [note: 'Target date by which final creative assets must be delivered to the client or campaign team.']
  estimated_cost numeric(15,2) [note: 'Estimated total cost to complete this production job, including labor, vendor fees, and production expenses. [estimated_cost >= 0]']
  estimated_hours numeric(10,2) [note: 'Estimated total production hours required to complete this job, used for resource planning and capacity management. [estimated_hours >= 0]']
  final_delivery_date date [note: 'Date when final approved creative assets were delivered to the client or campaign team.']
  format_specifications text [note: 'Technical format requirements for the deliverables (e.g., dimensions, file types, color space, resolution, duration). Free-text field capturing brief requirements from the creative brief.']
  internal_notes text [note: 'Internal notes and comments from the production team, not shared with the client. May include production challenges, resource constraints, or process observations.']
  is_billable boolean [not null, default: false, note: 'Indicates whether this production job is billable to the client or is internal/non-billable work.']
  job_description text [note: 'Detailed description of the production job scope, objectives, and deliverables as defined in the creative brief or project plan.']
  job_name text [not null, note: 'Human-readable name or title of the production job, typically describing the deliverable or campaign element.']
  job_number text [not null, note: 'Externally-known unique job number assigned by the production management system (e.g., Workfront). Format typically includes prefix and sequential number. [job_number ~ \'^[A-Z]{2,4}-[0-9]{6,8}$\']']
  job_status text [not null, note: 'Current lifecycle status of the production job. Values: briefed (job briefed, not started), in-production (active production work), internal-review (internal creative review), qa (quality assurance check), client-review (submitted to client), revisions (rework requested), approved (client approved), delivered (final assets delivered), cancelled (job cancelled). [→ ref.job_status]']
  job_type text [note: 'Category of creative production work. Values: print (print advertising), digital (digital display/banner), video (video production), audio (radio/podcast), ooh (Out-of-Home static), dooh (Digital Out-of-Home), ctv (Connected TV), social (social media creative), experiential (event/activation), motion-graphics (animation/motion design). [→ ref.job_type]']
  legal_review_required boolean [not null, default: false, note: 'Indicates whether this production job requires legal or regulatory compliance review (e.g., for claims, disclosures, or regulated industries).']
  legal_review_status text [note: 'Status of legal compliance review for this job. Values: not-required (legal review not needed), pending (review in progress), approved (legally compliant), rejected (non-compliant), conditional (approved with modifications). [legal_review_status IN (\'not-required\', \'pending\', \'approved\', \'rejected\', \'conditional\')]']
  priority_level text [note: 'Business priority assigned to this production job, determining resource allocation and scheduling urgency. [priority_level IN (\'low\', \'normal\', \'high\', \'urgent\', \'critical\')]']
  production_completion_date date [note: 'Date when production work was completed and job moved to review or delivery status.']
  production_start_date date [note: 'Date when active production work began on this job.']
  revision_count integer [note: 'Total number of revision rounds requested by internal reviewers or client during the production lifecycle. [revision_count >= 0]']
  sap_wbs_element text [note: 'SAP Project Systems WBS element code used for cost tracking and financial reconciliation of this production job.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (job_number) [unique]
  }
}

Table creative.proof [note: 'Captures each formal proofing round submitted for client or internal review via Workfront Proofing. Records proof type (concept, copy, layout, final art, legal, accessibility), proof stage (internal, client round 1/2/3, final), reviewer assignments, due date, submission timestamp, overall proof decision (approved, approved-with-changes, rejected), and decision timestamp. Distinct from asset_version in that a proof is a formal review event with stakeholder decisions and SLA tracking, not merely a file iteration. Supports agency SLA compliance reporting on review turnaround times.'] {
  proof_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the proof record. Primary key.']
  asset_version_id uuid [not null, note: 'Reference to the specific asset version being proofed in this review cycle. [→ creative.asset_version]']
  campaign_id uuid [note: 'Reference to the campaign this proof is associated with, enabling campaign-level proof tracking and SLA reporting. [→ media_ops_db.campaign.campaign (not enforced)]']
  creative_deliverable_id uuid [note: 'Foreign key linking to creative.creative_deliverable. Business justification: A proof is submitted to validate a specific creative deliverable — the proof round is the formal approval mechanism for a named deliverable output. While proof already links to asset_version (the spec [→ creative.creative_deliverable]']
  deliverable_tracker_id uuid [note: 'Foreign key linking to project.deliverable_tracker. Business justification: A proof is the review/approval mechanism for a tracked deliverable. Linking proof to deliverable_tracker enables end-to-end delivery and approval workflow reporting — advertising agencies need to reco [→ project.deliverable_tracker]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Proofs are approval artifacts within initiatives. Linking enables workflow tracking, approval cycle analysis, timeline management, and client satisfaction measurement at the initiative level. Essentia [→ project.initiative]']
  milestone_id uuid [note: 'Foreign key linking to project.milestone. Business justification: Proofs are approval gates at milestones. Linking enables contractual compliance, payment release validation, client sign-off tracking, and milestone achievement verification. Critical for contract man [→ project.milestone]']
  production_job_id uuid [note: 'Foreign key linking to creative.production_job. Business justification: Proofs are submitted during production jobs as part of the creative review workflow. This link provides operational context: which production job is this proof part of? Supports workflow tracking, SLA [→ creative.production_job]']
  sla_id uuid [note: 'Foreign key linking to contract.sla. Business justification: Proof review cycles are governed by contracted SLA turnaround commitments. proof.sla_met_flag and sla_target_hours are denormalized SLA data; linking to the governing SLA record enables breach reporti [→ crm_db.contract.sla (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Proofing platforms (Workfront Proof, Ziflow, Aproove) are often external SaaS vendors. Required for vendor contract management, platform cost allocation, and tech stack governance in creative operatio [→ media_ops_db.vendor.supplier (not enforced)]']
  task_id uuid [note: 'Foreign key linking to project.task. Business justification: Proofs are approval tasks in project schedules. Linking enables dependency management, timeline tracking, task completion validation, and approval workflow automation. Critical for schedule management [→ project.task]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: Proofs are approval milestones within work packages. Linking enables critical path management, approval cycle tracking, and schedule impact analysis. Essential for timeline management and client coord [→ project.work_package]']
  approval_count integer [note: 'Number of reviewers who approved the proof (either approved or approved with changes). Used for consensus tracking. [approval_count >= 0]']
  automated_check_flag boolean [not null, default: false, note: 'Indicates whether automated compliance checks (legal, accessibility, brand guidelines) were run on this proof. True = automated checks performed, False = manual review only.']
  automated_check_result text [note: 'Result of automated compliance checks if performed. Pass = all checks passed, Fail = critical issues found, Warning = minor issues flagged, Not Applicable = no automated checks run. [automated_check_result IN (\'pass\', \'fail\', \'warning\', \'not_applicable\')]']
  comment_count integer [note: 'Total number of comments and annotations submitted by all reviewers on this proof. Indicator of feedback volume and creative iteration intensity. [comment_count >= 0]']
  decision_timestamp timestamptz [note: 'Date and time when the overall proof decision was finalized. Used as the end point for SLA turnaround time calculations.']
  due_date date [note: 'Target date by which all reviewers must complete their review and provide decisions. Used for SLA compliance tracking.']
  escalation_flag boolean [not null, default: false, note: 'Indicates whether this proof was escalated to senior stakeholders due to missed SLA, critical feedback, or client dissatisfaction. True = escalated, False = normal workflow.']
  escalation_reason text [note: 'Free-text explanation of why the proof was escalated (e.g., \'Client rejected 3 consecutive rounds\', \'SLA missed by 48 hours\').']
  instructions text [note: 'Free-text instructions or context provided to reviewers about what to focus on in this proof (e.g., \'Please review headline copy for brand voice compliance\').']
  overall_decision text [note: 'Consolidated decision outcome across all assigned reviewers. Approved = all reviewers approved, Approved with Changes = approved but revisions requested, Rejected = requires major rework, Pending = awaiting reviewer decisions. [overall_decision IN (\'approved\', \'approved_with_changes\', \'rejected\', \'pending\')]']
  proof_name text [not null, note: 'Descriptive name of the proof, typically derived from the asset name and proof round (e.g., \'Q1 Campaign Hero Banner - Client Round 2\').']
  proof_number text [not null, note: 'Human-readable business identifier for the proof, typically auto-generated in format PRF-YYYYMMDD or similar. [proof_number ~ \'^PRF-[0-9]{8}$\']']
  proof_status text [not null, note: 'Current lifecycle status of the proof. Draft = being prepared, Submitted = sent to reviewers, In Review = active review in progress, Approved = accepted as-is, Approved with Changes = accepted with minor revisions, Rejected = requires major rework, Cancelled = proof withdrawn. [→ ref.proof_status]']
  proof_type text [note: 'Type of proof being submitted for review. Concept = early ideation, Copy = text/messaging review, Layout = design structure, Final Art = production-ready creative, Legal = regulatory compliance review, Accessibility = WCAG/ADA compliance, Brand Compliance = brand guideline adherence. [→ ref.proof_type]']
  rejection_count integer [note: 'Number of reviewers who rejected the proof. Used for quality control and creative iteration analysis. [rejection_count >= 0]']
  reviewer_count integer [note: 'Total number of reviewers assigned to this proof. Used for workload and stakeholder engagement analysis. [reviewer_count >= 0]']
  round_number integer [note: 'Sequential round number for this proof within the asset version lifecycle (1 = first proof, 2 = second proof after revisions, etc.).']
  sla_met_flag boolean [not null, default: false, note: 'Boolean indicator of whether the proof review was completed within the SLA target hours. True = SLA met, False = SLA missed.']
  stage text [note: 'Stage of the proofing workflow. Internal = agency-only review, Client Round 1/2/3 = sequential client review cycles, Final = final approval before production. [stage IN (\'internal\', \'client_round_1\', \'client_round_2\', \'client_round_3\', \'final\')]']
  submission_timestamp timestamptz [note: 'Date and time when the proof was formally submitted to reviewers. Used as the start point for SLA turnaround time calculations.']
  turnaround_time_hours numeric(10,2) [note: 'Calculated elapsed time in hours between submission_timestamp and decision_timestamp. Key metric for agency SLA compliance reporting on review cycle speed. [turnaround_time_hours >= 0]']
  url text [note: 'Direct URL link to the proof in the Workfront Proofing system for reviewer access and audit trail. [url ~ \'^https?://.*$\']']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (proof_number) [unique]
  }
}

Table project.assignment [note: 'Operational record linking a specific worker or team member to a task or work package within a project. Captures assignee worker reference, task or work package reference, assignment role (lead, contributor, reviewer, approver), planned hours, actual hours logged, assignment start date, assignment end date, allocation percentage, billable flag, billing rate applied, assignment status (active, completed, reassigned), and reassignment reason. Bridges project execution with talent workforce data and enables utilization tracking at the task level.'] {
  assignment_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the assignment record. Primary key.']
  contract_rate_card_id uuid [note: 'Foreign key linking to contract.contract_rate_card. Business justification: project_assignment has billing_rate and cost_rate that must be validated against the contracted rate card header. In advertising agencies, assignment billing rates are governed by client-negotiated ra [→ crm_db.contract.contract_rate_card (not enforced)]']
  initiative_id uuid [not null, note: 'Reference to the parent project to which this assignment belongs. [→ project.initiative]']
  rate_card_line_id uuid [note: 'Foreign key linking to contract.rate_card_line. Business justification: Individual assignments in advertising agencies are priced at specific rate card line items (e.g., Senior Art Director at $X/hr per the SOW rate card). rate_card_line has role_title, seniority_level, u [→ crm_db.contract.rate_card_line (not enforced)]']
  reassigned_from_project_assignment_id uuid [note: 'Self-referencing FK on project_assignment (reassigned_from_project_assignment_id) [→ project.assignment]']
  resource_plan_id uuid [note: 'Foreign key linking to project.resource_plan. Business justification: project_assignment (actual staffing) fulfills project_resource_plan (demand plan). Linking the assignment back to the resource plan it was created to fulfill closes the demand-to-actuals loop: agencie [→ project.resource_plan]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Resource assignments are scoped to SOWs. Agencies track which SOW funds each assignment for cost allocation, billing rate application, and ensuring resource deployment aligns with contractual scope an [→ crm_db.contract.sow (not enforced)]']
  task_id uuid [not null, note: 'Reference to the specific task or work package within the project that this assignment addresses. [→ project.task]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: The product description explicitly states project_assignment links \'a specific worker or team member to a task or work package.\' The existing FK covers task_id but work_package_id is missing. Some ass [→ project.work_package]']
  actual_hours numeric(10,2) [note: 'The actual number of hours logged by the worker against the assigned task. Used for utilization tracking and billing. [actual_hours >= 0]']
  allocation_percentage numeric(5,2) [note: 'The percentage of the worker\'s capacity allocated to this assignment, expressed as a decimal (e.g., 50.00 for 50% allocation). [allocation_percentage BETWEEN 0 AND 100]']
  assigned_timestamp timestamptz [note: 'The date and time when the assignment was created or assigned to the worker.']
  assignment_role text [note: 'The role or capacity in which the worker is assigned to the task (e.g., lead, contributor, reviewer, approver, observer, consultant). [assignment_role IN (\'lead\', \'contributor\', \'reviewer\', \'approver\', \'observer\', \'consultant\')]']
  assignment_status text [not null, note: 'Current lifecycle status of the assignment indicating whether it is active, completed, reassigned, on hold, or cancelled. [assignment_status IN (\'active\', \'completed\', \'reassigned\', \'on_hold\', \'cancelled\')]']
  billable_flag boolean [not null, default: false, note: 'Indicates whether the hours worked on this assignment are billable to the client (True) or non-billable (False).']
  billing_rate numeric(10,2) [note: 'The hourly billing rate applied to this assignment for client invoicing purposes. Confidential business data. [billing_rate >= 0]']
  completed_timestamp timestamptz [note: 'The date and time when the assignment was marked as completed by the worker or project manager.']
  cost_rate numeric(10,2) [note: 'The internal cost rate per hour for the worker on this assignment, used for profitability analysis. Confidential business data. [cost_rate >= 0]']
  currency_code char(3) [note: 'Three-letter ISO 4217 currency code for billing and cost rates (e.g., USD, EUR, GBP). [currency_code ~ \'^[A-Z]{3}$\']']
  end_date date [note: 'The date on which the worker is scheduled to complete work on the assigned task. [end_date >= start_date]']
  notes text [note: 'Additional notes or instructions related to the assignment, such as special requirements or context for the worker.']
  overtime_eligible_flag boolean [not null, default: false, note: 'Indicates whether the worker is eligible for overtime compensation on this assignment (True) or not (False).']
  planned_hours numeric(10,2) [note: 'The estimated number of hours allocated for the worker to complete the assigned task. [planned_hours >= 0]']
  priority text [note: 'The priority level of this assignment relative to other assignments for the worker (critical, high, medium, low). [priority IN (\'critical\', \'high\', \'medium\', \'low\')]']
  reassigned_timestamp timestamptz [note: 'The date and time when the assignment was reassigned to a different worker, if applicable.']
  reassignment_reason text [note: 'Free-text explanation for why the assignment was reassigned to a different worker, if applicable.']
  skill_required text [note: 'The primary skill or competency required for this assignment (e.g., copywriting, art direction, media planning, data analysis).']
  start_date date [note: 'The date on which the worker is scheduled to begin work on the assigned task.']
  utilization_category text [note: 'Classification of the assignment for workforce utilization reporting (e.g., client billable, internal project, training, administrative, bench). [utilization_category IN (\'client_billable\', \'internal_project\', \'training\', \'administrative\', \'bench\')]']
  work_location text [note: 'Indicates whether the assignment is to be performed on-site at the client or agency location, remotely, or in a hybrid arrangement. [work_location IN (\'on_site\', \'remote\', \'hybrid\')]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.deliverable_tracker [note: 'Operational tracking record for each project deliverable — monitoring production progress from brief through final delivery. Captures deliverable name, deliverable type (creative asset, media plan, strategy deck, report, campaign setup, trafficking sheet, etc.), associated work package, planned delivery date, actual delivery date, delivery status (not started, in production, in review, approved, delivered, rejected), review round count, client approval status, format specifications, file reference, and delivery channel (email, portal, FTP, DAM). Distinct from contract.deliverable (contractual commitment) — this is the operational production tracking record.'] {
  deliverable_tracker_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the deliverable tracking record. Primary key for operational tracking of project deliverables from brief through final delivery.']
  campaign_id uuid [note: 'Reference to the campaign this deliverable supports, if applicable. Links deliverable to the broader campaign execution. [→ media_ops_db.campaign.campaign (not enforced)]']
  contract_deliverable_id uuid [note: 'Reference to the contractual deliverable commitment in the Statement of Work (SOW) or Insertion Order (IO). Links operational tracking to contractual obligation. [→ crm_db.contract.contract_deliverable (not enforced)]']
  initiative_id uuid [not null, note: 'Reference to the parent project under which this deliverable is being produced. [→ project.initiative]']
  milestone_id uuid [note: 'Foreign key linking to project.milestone. Business justification: Deliverables are reviewed and approved at milestone gates (project_milestone has is_billing_trigger and is_contractual_gate flags). Linking deliverable_tracker to project_milestone enables the system [→ project.milestone]']
  plan_id uuid [note: 'Foreign key linking to media.plan. Business justification: Media plans are contractual deliverables tracked through project delivery workflows. Required for client approval gates, billing triggers tied to plan delivery, and SOW compliance verification in agen [→ media_ops_db.media.plan (not enforced)]']
  project_brief_id uuid [note: 'Foreign key linking to project.project_brief. Business justification: Deliverables are defined and scoped in the project_brief (key_deliverables, scope_description, success_criteria). Linking deliverable_tracker to project_brief provides direct traceability from the bri [→ project.project_brief]']
  revision_of_deliverable_tracker_id uuid [note: 'Self-referencing FK on deliverable_tracker (revision_of_deliverable_tracker_id) [→ project.deliverable_tracker]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Deliverables in advertising (video assets, display creatives, media placements) are produced by specific vendors. Linking supplier_id to deliverable_tracker enables vendor-level delivery performance r [→ media_ops_db.vendor.supplier (not enforced)]']
  task_id uuid [note: 'Foreign key linking to project.task. Business justification: A deliverable is produced by executing specific tasks. deliverable_tracker already links to work_package_id (the container) but lacks a direct link to the specific task that produces the deliverable. [→ project.task]']
  trafficking_instruction_id uuid [note: 'Foreign key linking to media.trafficking_instruction. Business justification: Trafficking instructions are formal deliverables in ad agency project management — they must be authored, reviewed, approved, and sent to ad servers. Project teams track each instruction as a delivera [→ media_ops_db.media.trafficking_instruction (not enforced)]']
  work_package_id uuid [note: 'Reference to the work package or work breakdown structure element that this deliverable belongs to. [→ project.work_package]']
  actual_delivery_date date [note: 'Actual date on which the deliverable was delivered. Used to measure on-time delivery performance and project execution accuracy.']
  actual_hours numeric(10,2) [note: 'Actual effort in hours logged against this deliverable. Used to measure estimation accuracy and project profitability. [actual_hours >= 0]']
  approved_timestamp timestamptz [note: 'Timestamp when the deliverable received final client approval. Marks formal acceptance and completion of the deliverable lifecycle.']
  client_approval_status text [note: 'Current approval state from the client perspective. Indicates whether the client has formally accepted the deliverable. [client_approval_status IN (\'pending\', \'approved\', \'rejected\', \'approved_with_changes\', \'not_required\')]']
  compliance_check_status text [note: 'Status of regulatory and brand compliance review. Ensures deliverable meets legal, regulatory, and brand guideline requirements before delivery. [compliance_check_status IN (\'not_required\', \'pending\', \'passed\', \'failed\')]']
  deliverable_name text [not null, note: 'Business name or title of the deliverable being tracked (e.g., \'Q4 Brand Campaign Video\', \'Media Plan Deck\', \'Trafficking Sheet\').']
  deliverable_status text [not null, note: 'Current lifecycle status of the deliverable in the production workflow. Tracks progression from initiation through final delivery. [→ ref.deliverable_status]']
  deliverable_type text [note: 'Classification of the deliverable by format and purpose. Distinguishes creative assets from strategic documents, operational setup files, and reporting outputs. [→ ref.deliverable_type]']
  delivered_timestamp timestamptz [note: 'Precise timestamp when the deliverable was marked as delivered. Provides exact delivery time for Service Level Agreement (SLA) measurement.']
  delivery_channel text [note: 'Method or platform through which the deliverable was or will be transmitted to the recipient (e.g., email, client portal, FTP, DAM system). [→ ref.delivery_channel]']
  delivery_notes text [note: 'Free-text notes accompanying the deliverable delivery. May include usage instructions, context, or special handling requirements.']
  estimated_hours numeric(10,2) [note: 'Planned effort in hours required to complete this deliverable. Used for resource planning and capacity management. [estimated_hours >= 0]']
  file_reference text [note: 'File path, URL, or Digital Asset Management (DAM) system reference pointing to the deliverable asset location.']
  format_specification text [note: 'Technical format requirements for the deliverable (e.g., \'MP4 1920x1080 30fps\', \'PDF print-ready CMYK\', \'HTML5 300x250\'). Ensures deliverable meets technical specifications.']
  internal_approval_status text [note: 'Internal agency approval status before client submission. Ensures quality control and brand compliance before external delivery. [internal_approval_status IN (\'pending\', \'approved\', \'rejected\', \'not_required\')]']
  is_billable boolean [not null, default: false, note: 'Indicates whether this deliverable is billable to the client or is part of non-billable agency overhead or pro-bono work.']
  planned_delivery_date date [note: 'Target date by which the deliverable is scheduled to be completed and delivered to the client or internal stakeholder.']
  priority text [note: 'Business priority level assigned to this deliverable. Drives resource allocation and scheduling decisions. [priority IN (\'critical\', \'high\', \'medium\', \'low\')]']
  rejection_reason text [note: 'Explanation provided when a deliverable is rejected by client or internal reviewer. Captures feedback for rework and process improvement.']
  review_round_count integer [note: 'Number of review cycles the deliverable has undergone. Tracks iteration intensity and helps identify scope creep or unclear requirements. [review_round_count >= 0]']
  source_system_deliverable_code text [note: 'Original identifier from the source project management or work management system (e.g., Workfront task ID, Monday.com item ID).']
  source_system_name text [note: 'Name of the operational system from which this deliverable tracking record originated (e.g., \'Workfront\', \'Monday.com\', \'Asana\').']
  version_number text [note: 'Version identifier for the deliverable (e.g., \'v1.0\', \'v2.3\', \'Final\'). Tracks iteration history and ensures version control.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.task [note: 'Atomic unit of work assigned to an individual or team within a work package. Captures task name, description, task type (creative production, copy writing, media trafficking, client review, QA, approval, etc.), assigned worker reference, assigned team, planned start date, planned end date, actual start date, actual end date, estimated hours, logged hours, completion percentage, priority, status (not started, in progress, blocked, complete), dependency type, predecessor task reference, and source system task ID from Workfront or Monday.com. The operational heartbeat of project execution tracking.'] {
  task_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the task. Primary key.']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Tasks need cost center tracking for time-based costing and departmental charge-back. Critical for labor cost allocation when time entries roll up to tasks for financial posting. [→ erp_db.finance.cost_center (not enforced)]']
  initiative_id uuid [note: 'Reference to the project this task belongs to. [→ project.initiative]']
  parent_task_id uuid [note: 'Self-referencing FK on task (parent_task_id) [→ project.task]']
  primary_predecessor_task_id uuid [note: 'Reference to the task that must be completed or started before this task can proceed, based on the dependency type. [→ project.task]']
  work_package_id uuid [not null, note: 'Reference to the parent work package that contains this task. [→ project.work_package]']
  actual_end_date date [note: 'The actual date when this task was completed. [actual_end_date >= actual_start_date]']
  actual_start_date date [note: 'The actual date when work on this task began.']
  approval_status text [note: 'The current approval status of the task deliverable (not submitted, pending, approved, rejected, changes requested). [approval_status IN (\'not_submitted\', \'pending\', \'approved\', \'rejected\', \'changes_requested\')]']
  blocked_reason text [note: 'Description of the reason why this task is blocked or cannot proceed.']
  completed_timestamp timestamptz [note: 'The date and time when this task was marked as complete.']
  completion_percentage numeric(5,2) [note: 'The percentage of work completed for this task, expressed as a value between 0 and 100. [completion_percentage BETWEEN 0 AND 100]']
  deliverable_type text [note: 'The type of deliverable or output expected from this task (e.g., creative asset, media plan, trafficking sheet, approval document).']
  dependency_type text [note: 'The type of dependency relationship this task has with its predecessor (finish-to-start, start-to-start, finish-to-finish, start-to-finish, or none). [dependency_type IN (\'finish_to_start\', \'start_to_start\', \'finish_to_finish\', \'start_to_finish\', \'none\')]']
  estimated_hours numeric(10,2) [note: 'The estimated number of hours required to complete this task. [estimated_hours >= 0]']
  is_billable boolean [not null, default: false, note: 'Boolean flag indicating whether the hours logged on this task are billable to the client.']
  is_milestone boolean [not null, default: false, note: 'Boolean flag indicating whether this task represents a project milestone.']
  logged_hours numeric(10,2) [note: 'The actual number of hours logged or worked on this task. [logged_hours >= 0]']
  notes text [note: 'Additional notes, comments, or instructions related to this task.']
  planned_end_date date [note: 'The scheduled date when this task is planned to be completed. [planned_end_date >= planned_start_date]']
  planned_start_date date [note: 'The scheduled date when work on this task is planned to begin.']
  priority text [note: 'The priority level assigned to this task indicating its relative importance and urgency. [priority IN (\'low\', \'medium\', \'high\', \'urgent\', \'critical\')]']
  source_system_name text [note: 'The name of the operational system of record from which this task was sourced (e.g., Workfront, Monday.com). [source_system_name IN (\'workfront\', \'monday\', \'other\')]']
  source_system_task_code text [note: 'The unique identifier for this task in the source system (Workfront or Monday.com).']
  task_description text [note: 'Detailed description of the work to be performed in this task.']
  task_name text [not null, note: 'The name or title of the task.']
  task_status text [not null, note: 'Current lifecycle status of the task (not started, in progress, blocked, complete, cancelled, on hold). [task_status IN (\'not_started\', \'in_progress\', \'blocked\', \'complete\', \'cancelled\', \'on_hold\')]']
  task_type text [note: 'The category or type of work this task represents (e.g., creative production, copywriting, media trafficking, client review, quality assurance, approval). [task_type IN (\'creative_production\', \'copywriting\', \'media_trafficking\', \'client_review\', \'qa\', \'approval\')]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.time_entry [note: 'Individual time entry record submitted by agency staff against a specific project task or work package — the granular time-tracking record at the project level. Captures worker reference, project reference, work package reference, task reference, entry date, hours logged, activity type (creative development, strategy, client management, production, media planning, QA, admin), billable flag, billing rate, billable amount, approval status (submitted, approved, rejected), approver, and source system (Workfront/Monday.com timelog ID). Distinct from talent.timesheet (the aggregated pay-period timesheet header) — this is the line-level project time allocation record.'] {
  time_entry_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the time entry record. Primary key for the time entry entity.']
  adjusted_time_entry_id uuid [note: 'Self-referencing FK on time_entry (adjusted_time_entry_id) [→ project.time_entry]']
  assignment_id uuid [note: 'Foreign key linking to project.assignment. Business justification: Time entries are submitted by workers who operate under specific project assignments. Linking time_entry to project_assignment provides the assignment context (billing_rate, cost_rate, assignment_role [→ project.assignment]']
  contract_rate_card_id uuid [note: 'Foreign key linking to contract.contract_rate_card. Business justification: time_entry has billing_rate and cost_rate that must reconcile against the contracted rate card. Advertising agencies bill time against client-negotiated rate cards. This link enables billing validatio [→ crm_db.contract.contract_rate_card (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Time entries must post to cost centers for labor cost allocation, utilization reporting, and departmental P&L. Core requirement for agency financial systems integrating time tracking with GL posting. [→ erp_db.finance.cost_center (not enforced)]']
  finance_budget_id uuid [note: 'Foreign key linking to finance.finance_budget. Business justification: Time entries (labor costs) must be charged against the approved finance budget for labor cost tracking and budget consumption reporting. This is core agency resource management — time entries drive bu [→ erp_db.finance.finance_budget (not enforced)]']
  gl_account_id uuid [note: 'Foreign key linking to finance.gl_account. Business justification: Time entries require GL account assignment for payroll expense posting and revenue recognition. Essential for labor cost capitalization, WIP accounting, and financial statement preparation in agency o [→ erp_db.finance.gl_account (not enforced)]']
  initiative_id uuid [note: 'Reference to the project against which this time was logged. Links to the project domain project entity. [→ project.initiative]']
  rate_card_line_id uuid [note: 'Foreign key linking to contract.rate_card_line. Business justification: Time entries in advertising are billed at specific rate card line rates by role and service type. rate_card_line has unit_rate, role_title, service_type matching time_entry billing attributes. This li [→ crm_db.contract.rate_card_line (not enforced)]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Time is billed against SOWs. Agencies track SOW-level time for client invoicing, utilization reporting, and validating labor charges against SOW rate cards and authorized budget caps. [→ crm_db.contract.sow (not enforced)]']
  task_id uuid [not null, note: 'Reference to the specific task or deliverable against which time was logged. Links to the project.task entity. [→ project.task]']
  work_package_id uuid [note: 'Reference to the work package within the project. Represents a logical grouping of tasks for billing or resource planning purposes. [→ project.work_package]']
  activity_type text [note: 'The type of work activity performed during this time entry. Categorizes time for resource utilization analysis and billing purposes. [→ ref.activity_type]']
  approval_status text [not null, note: 'Current approval state of the time entry. Tracks the workflow from submission through manager approval for payroll and billing processing. [approval_status IN (\'draft\', \'submitted\', \'approved\', \'rejected\', \'pending_revision\')]']
  approval_timestamp timestamptz [note: 'The date and time when the time entry was approved or rejected by the approver. Null if not yet reviewed.']
  billable_amount numeric(12,2) [note: 'The total billable amount for this time entry, calculated as hours_logged multiplied by billing_rate. Null for non-billable entries. Used for revenue recognition and client invoicing. [billable_amount >= 0]']
  billing_rate numeric(10,2) [note: 'The hourly billing rate applied to this time entry for client invoicing. May vary by worker role, project contract terms, or activity type. Null for non-billable entries. [billing_rate >= 0]']
  cost_amount numeric(12,2) [note: 'The total internal cost for this time entry, calculated as hours_logged multiplied by cost_rate. Used for project margin analysis and financial reporting. [cost_amount >= 0]']
  cost_rate numeric(10,2) [note: 'The internal cost rate per hour for this worker. Used for project profitability analysis and resource cost tracking. Distinct from billing_rate. [cost_rate >= 0]']
  currency_code char(3) [note: 'Three-letter ISO 4217 currency code for the billable amount (e.g., USD, EUR, GBP). Supports multi-currency project billing. [currency_code ~ \'^[A-Z]{3}$\']']
  entry_date date [not null, note: 'The calendar date on which the work was performed. Used for timesheet aggregation and project timeline tracking.']
  hours_logged numeric(5,2) [not null, note: 'The number of hours worked on this task for the entry date. Supports fractional hours (e.g., 1.5 hours, 0.25 hours). [hours_logged >= 0]']
  is_billable boolean [not null, default: false, note: 'Indicates whether this time entry is billable to the client. True for billable time, False for non-billable or internal time.']
  is_locked boolean [not null, default: false, note: 'Indicates whether this time entry is locked and cannot be edited. True when the entry has been processed for payroll or billing. False for editable entries.']
  is_overtime boolean [not null, default: false, note: 'Indicates whether this time entry represents overtime hours. True for overtime, False for regular hours. Used for payroll processing and labor cost analysis.']
  location text [note: 'The physical or virtual location where the work was performed. Used for resource allocation analysis and compliance with remote work policies. [location IN (\'office\', \'remote\', \'client_site\', \'hybrid\')]']
  notes text [note: 'Optional free-text notes or comments provided by the worker describing the work performed. Used for detailed activity tracking and client reporting.']
  rejection_reason text [note: 'Free-text explanation provided by the approver when rejecting a time entry. Null for approved or pending entries.']
  source_system_code text [note: 'The unique identifier for this time entry in the source system (Workfront or Monday.com). Used for data lineage and reconciliation.']
  source_system_name text [note: 'The name of the system from which this time entry was ingested. Supports multi-system time tracking integration. [source_system_name IN (\'workfront\', \'monday_com\', \'workday\', \'manual_entry\')]']
  submitted_timestamp timestamptz [note: 'The date and time when the worker submitted this time entry for approval. Null for draft entries.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.initiative [note: 'Master record for an agency project or engagement — the authoritative SSOT for project identity, scope, and lifecycle within the agency. Captures project name, type (campaign production, brand strategy, media planning, PR activation, etc.), status (briefing, planning, in-flight, on-hold, completed, cancelled), priority, start and end dates, planned vs. actual duration, client account reference, associated campaign reference, owning department, project manager, delivery methodology (agile, waterfall, hybrid), source system (Workfront/Monday.com) project ID, and overall health indicator. Serves as the top-level container for all work breakdown structures, tasks, milestones, and resource assignments.'] {
  initiative_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the agency project or engagement. Primary key.']
  advertiser_id uuid [note: 'Reference to the client advertiser account for whom this project is being executed. [→ crm_db.client.advertiser (not enforced)]']
  agency_relationship_id uuid [note: 'Foreign key linking to client.agency_relationship. Business justification: Projects are delivered under specific agency relationship agreements (AOR, project-based retainer, pitch work). Tracking which relationship governs the work is essential for billing rules, scope bound [→ crm_db.client.agency_relationship (not enforced)]']
  agreement_id uuid [note: 'Foreign key linking to contract.agreement. Business justification: Master agreements govern multi-project client relationships. Agencies link initiatives to MSAs to apply correct rate cards, enforce compliance obligations, and manage multi-year retainer terms across [→ crm_db.contract.agreement (not enforced)]']
  attribution_model_id uuid [note: 'Foreign key linking to performance.attribution_model. Business justification: Strategic initiatives define attribution methodology for performance evaluation. Real business process: campaign planning phase where strategists select attribution model (last-click, linear, data-dri [→ adserver_db.performance.attribution_model (not enforced)]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Initiatives are executed on behalf of a specific brand. Brand-level reporting — SOV tracking, brand health metrics, budget utilization by brand — requires linking initiatives to client_brand. initiati [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [note: 'Reference to the associated marketing campaign if this project is part of a broader campaign initiative. Nullable for non-campaign projects. [→ media_ops_db.campaign.campaign (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Projects must be assigned to cost centers for financial reporting, budget allocation, and P&L tracking in agency operations. Essential for departmental profitability analysis and overhead allocation. [→ erp_db.finance.cost_center (not enforced)]']
  parent_initiative_id uuid [note: 'Self-referencing FK on initiative (parent_initiative_id) [→ project.initiative]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Initiatives execute SOW-defined scope. Agencies track SOW-to-project mapping for revenue recognition, deliverable tracking, budget burn analysis, and client invoicing against contractual commitments. [→ crm_db.contract.sow (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Projects/initiatives frequently engage vendors for media buying, tech platforms, creative production. Tracking primary supplier enables project vendor management, cost allocation, and vendor performan [→ media_ops_db.vendor.supplier (not enforced)]']
  actual_cost numeric(18,2) [note: 'Total actual cost incurred to date for labor, materials, and external expenses. Updated as costs are recorded. [actual_cost >= 0]']
  actual_duration_days integer [note: 'Actual elapsed duration of the project in calendar days. Populated upon project completion. [actual_duration_days >= 0]']
  billing_type text [note: 'Commercial model under which the project is billed to the client. [billing_type IN (\'fixed_fee\', \'time_and_materials\', \'retainer\', \'performance_based\', \'hybrid\')]']
  budget_amount numeric(18,2) [note: 'Total approved budget allocated for this project in the agency\'s reporting currency. [budget_amount >= 0]']
  budget_currency_code char(3) [note: 'Three-letter ISO 4217 currency code for the project budget (e.g., USD, GBP, EUR). [budget_currency_code ~ \'^[A-Z]{3}$\']']
  cancellation_date date [note: 'Date when the project was formally cancelled. Populated only for cancelled projects.']
  cancellation_reason text [note: 'Explanation for why the project was cancelled (e.g., client budget cuts, scope changes, strategic pivot).']
  client_satisfaction_score numeric(3,2) [note: 'Client-reported satisfaction rating for the project, typically on a scale of 1.00 to 5.00. Captured post-delivery or at milestones.']
  completion_date date [note: 'Actual date when all project deliverables were completed and accepted by the client.']
  deliverables_summary text [note: 'High-level summary of key deliverables expected from this project (e.g., creative assets, media plans, campaign reports).']
  delivery_methodology text [note: 'Project management methodology applied for planning and execution (e.g., agile sprints, waterfall phases, hybrid approach). [delivery_methodology IN (\'agile\', \'waterfall\', \'hybrid\', \'kanban\')]']
  end_date date [note: 'Planned or actual date when project work is scheduled to complete or was completed. [end_date >= start_date]']
  health_indicator text [note: 'Overall health status of the project based on schedule, budget, scope, and quality metrics. Green indicates on-track, yellow indicates at-risk, red indicates critical issues. [health_indicator IN (\'green\', \'yellow\', \'red\')]']
  initiative_name text [not null, note: 'Human-readable name of the project or engagement, used for identification and reporting.']
  initiative_status text [not null, note: 'Current lifecycle status of the project indicating its stage in the execution workflow. [initiative_status IN (\'briefing\', \'planning\', \'in_flight\', \'on_hold\', \'completed\', \'cancelled\')]']
  is_billable boolean [not null, default: false, note: 'Indicates whether this project is billable to the client (true) or internal/non-billable (false).']
  is_confidential boolean [not null, default: false, note: 'Indicates whether this project is subject to confidentiality or non-disclosure agreements requiring restricted access.']
  kickoff_date date [note: 'Date of the formal project kickoff meeting with the client and internal team.']
  notes text [note: 'Free-form notes capturing additional context, special instructions, or important observations about the project.']
  owning_department text [note: 'Primary agency department responsible for delivering this project. [→ ref.owning_department]']
  planned_duration_days integer [note: 'Originally estimated duration of the project in calendar days from start to end. [planned_duration_days >= 0]']
  priority text [note: 'Business priority level assigned to the project for resource allocation and scheduling decisions. [priority IN (\'critical\', \'high\', \'medium\', \'low\')]']
  project_code text [not null, note: 'Externally-known unique alphanumeric code assigned to the project for client communication and billing. Typically follows agency naming convention. [project_code ~ \'^[A-Z0-9]{6,12}$\']']
  project_type text [note: 'Classification of the project based on the primary service offering or deliverable type. [→ ref.project_type]']
  risk_level text [note: 'Overall risk assessment for the project based on complexity, dependencies, client volatility, and resource constraints. [risk_level IN (\'low\', \'medium\', \'high\', \'critical\')]']
  scope_description text [note: 'Detailed narrative describing the project scope, objectives, deliverables, and boundaries.']
  source_system_code text [note: 'Unique project identifier from the originating system of record (Workfront, Monday.com, or other project management platform).']
  source_system_name text [note: 'Name of the project management system from which this project record was ingested. [source_system_name IN (\'workfront\', \'monday\', \'asana\', \'jira\', \'smartsheet\')]']
  start_date date [note: 'Planned or actual date when project work officially begins.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (project_code) [unique]
  }
}

Table project.milestone [note: 'Significant scheduled checkpoint or deliverable gate within a project lifecycle. Captures milestone name, description, milestone type (kickoff, creative review, client approval, campaign launch, post-campaign report, billing trigger, contractual gate), planned date, actual date, status (upcoming, achieved, missed, deferred), owner, associated work package, linked SOW contractual milestone reference, and variance in days between planned and actual achievement. Used for client reporting, billing triggers, and executive project health dashboards.'] {
  milestone_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the project milestone. Primary key.']
  amendment_id uuid [note: 'Foreign key linking to contract.amendment. Business justification: Contract amendments in advertising frequently revise milestone dates and deliverable scope. Linking project_milestone.amendment_id → amendment provides the audit trail showing which amendment triggere [→ crm_db.contract.amendment (not enforced)]']
  initiative_id uuid [not null, note: 'Reference to the parent project to which this milestone belongs. [→ project.initiative]']
  replanned_from_project_milestone_id uuid [note: 'Self-referencing FK on project_milestone (replanned_from_project_milestone_id) [→ project.milestone]']
  sla_id uuid [note: 'Foreign key linking to contract.sla. Business justification: Contractual milestone gates in advertising are governed by SLAs (e.g., creative delivery turnaround SLAs). project_milestone.is_contractual_gate flag signals this need. Linking to sla enables SLA brea [→ crm_db.contract.sla (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Contractual campaign milestones (e.g., creative delivery gate, campaign launch) are often vendor-dependent in advertising. Linking supplier_id to project_milestone enables vendor-specific milestone tr [→ media_ops_db.vendor.supplier (not enforced)]']
  work_package_id uuid [not null, note: 'Reference to the associated work package or phase within the project structure. [→ project.work_package]']
  acceptance_criteria text [note: 'Specific, measurable criteria that must be met for the milestone to be considered successfully achieved and approved by stakeholders.']
  actual_date date [note: 'Actual date the milestone was achieved or completed. Null if milestone has not yet been reached.']
  approved_timestamp timestamptz [note: 'Timestamp when the milestone completion was formally approved by the designated approver. Null if not yet approved.']
  baseline_date date [note: 'Baseline date captured at project approval or contract signature, used for variance analysis and performance measurement against original commitment.']
  completion_percentage numeric(5,2) [note: 'Percentage of work completed toward achieving this milestone, expressed as a decimal (0.00 to 100.00). Used for progress tracking and earned value analysis. [completion_percentage BETWEEN 0 AND 100]']
  deliverable_description text [note: 'Detailed description of the tangible deliverable or output associated with this milestone (e.g., \'Final creative assets in all formats\', \'Campaign performance dashboard\', \'Client presentation deck\').']
  dependency_count integer [note: 'Number of predecessor tasks or milestones that must be completed before this milestone can be achieved. Used for dependency analysis and scheduling. [dependency_count >= 0]']
  forecast_date date [note: 'Current forecasted date for milestone completion based on project progress and risk assessment. Updated regularly during project execution.']
  is_billing_trigger boolean [not null, default: false, note: 'Boolean flag indicating whether achievement of this milestone triggers invoice generation or payment milestone per the client contract.']
  is_contractual_gate boolean [not null, default: false, note: 'Boolean flag indicating whether this milestone is a contractually binding checkpoint defined in the SOW, requiring formal client sign-off before proceeding.']
  is_critical_path boolean [not null, default: false, note: 'Boolean flag indicating whether this milestone lies on the project critical path. Delays to critical path milestones directly impact overall project completion date.']
  milestone_description text [note: 'Detailed description of the milestone deliverable, acceptance criteria, and business significance.']
  milestone_name text [not null, note: 'Business-friendly name of the milestone (e.g., \'Creative Concept Approval\', \'Campaign Launch\', \'Post-Campaign Report Delivery\').']
  milestone_type text [note: 'Classification of the milestone by its business function: kickoff (project initiation), creative_review (internal creative approval), client_approval (client sign-off gate), campaign_launch (media go-live), post_campaign_report (campaign performance delivery), billing_trigger (invoice generation event), contractual_gate (SOW-defined checkpoint). [→ ref.milestone_type]']
  notes text [note: 'Free-text field for additional context, issues, decisions, or stakeholder feedback related to the milestone.']
  planned_date date [note: 'Originally scheduled date for milestone achievement as defined in the project plan or SOW.']
  project_milestone_status text [not null, note: 'Current lifecycle status of the milestone: upcoming (not yet started), in_progress (work underway toward milestone), achieved (successfully completed on or before planned date), missed (completed after planned date or not completed by deadline), deferred (postponed to future date), cancelled (no longer required). [project_milestone_status IN (\'upcoming\', \'in_progress\', \'achieved\', \'missed\', \'deferred\', \'cancelled\')]']
  risk_level text [note: 'Current risk assessment for on-time milestone achievement: low (on track, no issues), medium (minor concerns, monitoring required), high (significant risk of delay), critical (delay imminent or already occurred). [risk_level IN (\'low\', \'medium\', \'high\', \'critical\')]']
  sow_milestone_reference text [note: 'External reference code linking this milestone to a contractual milestone defined in the client Statement of Work (SOW). Used for contractual compliance and billing trigger validation.']
  variance_days integer [note: 'Calculated variance in days between planned date and actual date. Positive values indicate delay (missed deadline), negative values indicate early completion. Null if milestone not yet achieved.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.project_brief [note: 'Internal project initiation brief that translates a client brief or SOW into an actionable agency project plan. Captures brief title, project type, originating client brief reference, associated campaign reference, strategic objectives, target audience summary, key deliverables list, channel mix, budget envelope, timeline constraints, success criteria, key stakeholders, creative direction notes, and brief status (draft, approved, in-execution). Distinct from client.client_brief (client-submitted) and creative.creative_brief (creative-specific) — this is the project management layer brief governing overall project execution.'] {
  project_brief_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the project brief record. Primary key.']
  advertiser_id uuid [note: 'Reference to the client advertiser for whom this project is being executed. [→ crm_db.client.advertiser (not enforced)]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Project briefs are scoped to a specific client brand (e.g., Nike Running vs. Nike Basketball), driving brand safety rules, creative direction, and brand-level budget allocation. Advertising PMs always [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [not null, note: 'Reference to the associated campaign that this project brief supports. [→ media_ops_db.campaign.campaign (not enforced)]']
  client_brief_id uuid [note: 'Reference to the originating client brief that this project brief translates into an actionable plan. [→ crm_db.client.client_brief (not enforced)]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: project_brief translates client briefs into actionable agency projects but currently has no direct link to the initiative product that represents the project execution. Adding initiative_id creates th [→ project.initiative]']
  segment_id uuid [note: 'Foreign key linking to audience.segment. Business justification: Project briefs specify primary target audience segments for campaign planning and creative development. Agencies link briefs to segments to ensure creative deliverables align with audience strategy an [→ cdp_db.audience.segment (not enforced)]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Project briefs operationalize SOW commitments. Agencies must track which SOW funds each brief to validate scope, budget authority, and deliverable alignment during project kickoff and execution. [→ crm_db.contract.sow (not enforced)]']
  superseded_project_brief_id uuid [note: 'Self-referencing FK on project_brief (superseded_project_brief_id) [→ project.project_brief]']
  target_persona_id uuid [note: 'Foreign key linking to audience.persona. Business justification: Project briefs reference target personas to guide strategic planning and creative direction. Agencies link briefs to personas to ensure all project deliverables (creative, media, messaging) align with [→ cdp_db.audience.persona (not enforced)]']
  approved_by text [note: 'Name or identifier of the individual who approved the project brief for execution.']
  approved_date date [note: 'Date when the project brief was formally approved for execution.']
  brand_safety_notes text [note: 'Brand safety considerations, content adjacency guidelines, and risk mitigation measures for media placement.']
  brief_status text [not null, note: 'Current lifecycle status of the project brief indicating its stage in the approval and execution workflow. [brief_status IN (\'draft\', \'submitted\', \'approved\', \'in_execution\', \'completed\', \'cancelled\')]']
  budget_currency_code char(3) [note: 'Three-letter ISO 4217 currency code for the budget envelope amount. [budget_currency_code ~ \'^[A-Z]{3}$\']']
  budget_envelope_amount numeric(18,2) [note: 'Total budget allocation or envelope amount approved for this project execution. [budget_envelope_amount >= 0]']
  channel_mix text [note: 'Description of the media and marketing channels to be utilized in this project (e.g., digital, TV, OOH, social, CTV).']
  completion_timestamp timestamptz [note: 'Timestamp when the project was marked as completed.']
  compliance_requirements text [note: 'Regulatory, legal, and compliance requirements applicable to this project (e.g., GDPR, CCPA, FTC guidelines, ASA standards).']
  creative_direction_notes text [note: 'High-level creative direction, brand guidelines, tone, messaging themes, and creative considerations for the project.']
  execution_start_timestamp timestamptz [note: 'Timestamp when project execution officially began following brief approval.']
  is_active boolean [not null, default: false, note: 'Boolean flag indicating whether the project brief is currently active and in use.']
  key_deliverables text [note: 'Comprehensive list of key deliverables, outputs, and work products expected from this project.']
  key_stakeholders text [note: 'List of key stakeholders, decision-makers, and approvers involved in this project from both agency and client sides.']
  measurement_framework text [note: 'Description of the measurement and analytics framework to be used for tracking project performance and outcomes.']
  planned_end_date date [note: 'Planned completion date for project execution as defined in the project brief. [planned_end_date >= planned_start_date]']
  planned_start_date date [note: 'Planned start date for project execution as defined in the project brief.']
  priority_level text [note: 'Priority classification of the project brief indicating urgency and resource allocation priority. [priority_level IN (\'critical\', \'high\', \'medium\', \'low\')]']
  project_type text [note: 'Classification of the project type indicating the nature of work to be performed. [project_type IN (\'campaign\', \'creative_development\', \'media_planning\', \'brand_strategy\', \'digital_marketing\', \'content_production\')]']
  risk_considerations text [note: 'Identified risks, dependencies, and mitigation strategies relevant to project execution.']
  scope_description text [note: 'Detailed description of the project scope, including in-scope and out-of-scope activities.']
  strategic_objectives text [note: 'High-level strategic goals and business objectives that this project aims to achieve for the client.']
  submitted_timestamp timestamptz [note: 'Timestamp when the project brief was submitted for approval.']
  success_criteria text [note: 'Defined success criteria and key performance indicators (KPIs) that will be used to measure project success.']
  target_audience_summary text [note: 'Summary description of the target audience demographics, psychographics, and behavioral characteristics for this project.']
  timeline_constraints text [note: 'Description of any timeline constraints, critical milestones, or deadline dependencies that impact project scheduling.']
  title text [not null, note: 'The descriptive title of the project brief that summarizes the project scope.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.project_budget [note: 'Project-level budget record defining the approved financial envelope for a project, distinct from finance.budget (which operates at cost center and campaign level). Captures project reference, budget version, budget type (original approved, revised, client-approved), total approved budget, budget by phase or work package, contingency reserve, management reserve, currency, approval date, approver, budget status (draft, approved, locked, over-budget), total committed spend, total actual spend, and remaining budget. Enables project financial control and client billing reconciliation.'] {
  project_budget_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the project budget record. Primary key.']
  amendment_id uuid [note: 'Foreign key linking to contract.amendment. Business justification: Contract amendments in advertising trigger project budget revisions (scope changes, budget increases). Linking project_budget.amendment_id → amendment provides the audit trail showing which amendment [→ crm_db.contract.amendment (not enforced)]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Agency project budgets are allocated and tracked at brand level for brand-level P&L and budget utilization reporting. Finance teams require direct brand attribution on project budgets to produce brand [→ crm_db.client.brand (not enforced)]']
  contract_insertion_order_id uuid [note: 'Foreign key linking to contract.contract_insertion_order. Business justification: In advertising agencies, project budgets are built directly against Insertion Orders — the IO is the spend authorization document. This link enables IO-to-budget reconciliation reporting, a core finan [→ crm_db.contract.contract_insertion_order (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Project budgets are posted to cost centers for management accounting and overhead allocation. project_budget has a denormalized cost_center_code plain attribute but no FK. Linking to cost_center enabl [→ erp_db.finance.cost_center (not enforced)]']
  finance_budget_id uuid [note: 'Foreign key linking to finance.finance_budget. Business justification: Agency project budgets must reconcile against the finance-controlled finance_budget for variance reporting, SOX compliance, and budget approval workflows. Finance teams need to trace project spend bac [→ erp_db.finance.finance_budget (not enforced)]']
  gl_account_id uuid [note: 'Foreign key linking to finance.gl_account. Business justification: Project budgets need GL account mapping for financial statement integration, accrual posting, and revenue/expense classification. Required for month-end close and financial reporting in agency ERP sys [→ erp_db.finance.gl_account (not enforced)]']
  initiative_id uuid [not null, note: 'Reference to the parent project for which this budget is defined. Links to the project master record. [→ project.initiative]']
  plan_id uuid [note: 'Foreign key linking to media.plan. Business justification: Project budgets allocate funds to specific media plans. Required for variance analysis between planned media spend and project budget, enabling financial forecasting, budget reallocation decisions, an [→ media_ops_db.media.plan (not enforced)]']
  revised_from_project_budget_id uuid [note: 'Self-referencing FK on project_budget (revised_from_project_budget_id) [→ project.project_budget]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Project budgets are allocated from SOW budgets. Finance tracks SOW-to-project budget mapping for billing reconciliation, variance analysis, and ensuring project spend does not exceed contractual autho [→ crm_db.contract.sow (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: project_budget contains a `third_party_vendor_budget` attribute, confirming per-vendor budget allocation is tracked. Linking supplier_id enables budget-vs-actual spend reporting by vendor — a standard [→ media_ops_db.vendor.supplier (not enforced)]']
  vendor_rate_card_id uuid [note: 'Foreign key linking to vendor.vendor_rate_card. Business justification: In advertising, project budgets for media and production are built from vendor rate cards. Linking vendor_rate_card_id to project_budget enables budget-to-rate-card traceability — auditors and finance [→ media_ops_db.vendor.vendor_rate_card (not enforced)]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: project_budget currently carries work_breakdown_structure_code as a free-text string reference to the WBS. Adding a proper FK work_package_id to project.work_package normalizes this relationship, repl [→ project.work_package]']
  approval_date date [note: 'Date on which this budget version was formally approved by the authorized approver or governance body.']
  approved_timestamp timestamptz [note: 'Timestamp when this budget version was formally approved. Captures the precise moment of approval for audit and compliance purposes.']
  baseline_budget_flag boolean [not null, default: false, note: 'Boolean flag indicating whether this budget version represents the original approved baseline for the project. True for the baseline version, False for revisions.']
  budget_status text [not null, note: 'Current lifecycle status of the budget: draft (in preparation), submitted (pending approval), approved (active), locked (no further changes), over-budget (exceeded threshold), or closed (project complete). [budget_status IN (\'draft\', \'submitted\', \'approved\', \'locked\', \'over_budget\', \'closed\')]']
  budget_type text [note: 'Classification of the budget record: original approved (baseline), revised (internal adjustment), client-approved (client sign-off), internal forecast (planning estimate), or contingency (reserve allocation). [budget_type IN (\'original_approved\', \'revised\', \'client_approved\', \'internal_forecast\', \'contingency\')]']
  client_approval_date date [note: 'Date on which the client formally approved this budget version. Null if not yet client-approved.']
  client_approved_flag boolean [not null, default: false, note: 'Boolean flag indicating whether this budget version has been formally approved by the client. True if client-approved, False otherwise.']
  contingency_reserve numeric(18,2) [note: 'Budget reserve allocated for identified risks and known-unknowns. Typically controlled by the project manager and released as needed for scope changes or risk mitigation.']
  creative_production_budget numeric(18,2) [note: 'Portion of the total budget allocated to creative development and production activities, including design, video production, photography, and Digital Asset Management (DAM). [creative_production_budget >= 0]']
  currency_code char(3) [not null, note: 'Three-letter ISO 4217 currency code for all monetary amounts in this budget (e.g., USD, EUR, GBP). [currency_code ~ \'^[A-Z]{3}$\']']
  effective_end_date date [note: 'Date on which this budget version ceases to be effective. Null for the current active budget version. [effective_end_date >= effective_start_date]']
  effective_start_date date [note: 'Date from which this budget version becomes effective and active for financial tracking and control.']
  fiscal_quarter text [note: 'Fiscal quarter to which this project budget primarily applies (Q1, Q2, Q3, Q4). Supports quarterly financial planning and Quarterly Business Review (QBR) processes. [fiscal_quarter IN (\'Q1\', \'Q2\', \'Q3\', \'Q4\')]']
  fiscal_year text [note: 'Fiscal year to which this project budget applies (e.g., 2024, 2025). Enables financial period alignment and year-over-year analysis. [fiscal_year ~ \'^[0-9]{4}$\']']
  labor_budget numeric(18,2) [note: 'Portion of the total budget allocated to labor costs, including salaries, contractor fees, and Full-Time Equivalent (FTE) resources. [labor_budget >= 0]']
  locked_timestamp timestamptz [note: 'Timestamp when this budget version was locked to prevent further modifications. Null if the budget is still open for changes.']
  management_reserve numeric(18,2) [note: 'Budget reserve allocated for unknown-unknowns and unplanned scope changes. Typically controlled by senior management and requires formal approval to access.']
  media_budget numeric(18,2) [note: 'Portion of the total budget allocated to media buying and placement costs across all channels (digital, broadcast, print, Out-of-Home (OOH), etc.). [media_budget >= 0]']
  notes text [note: 'Free-text field for additional notes, assumptions, constraints, or context related to this budget version. Supports audit trail and knowledge transfer.']
  remaining_budget numeric(18,2) [note: 'Calculated remaining budget available for allocation. Typically total_approved_budget minus (total_committed_spend + total_actual_spend). [remaining_budget >= 0]']
  revision_reason text [note: 'Textual explanation of why this budget version was revised from the previous version. Captures scope changes, client requests, cost overruns, or other justifications.']
  source_system_budget_code text [note: 'Original budget identifier from the source system (e.g., Workfront project budget ID, SAP Project Systems (PS) budget ID). Enables traceability and reconciliation.']
  source_system_name text [note: 'Name of the operational system from which this budget record originated (e.g., Workfront, SAP S/4HANA PS, Mediaocean Prisma). Supports data lineage and Extract Transform Load (ETL) auditing.']
  technology_budget numeric(18,2) [note: 'Portion of the total budget allocated to technology costs, including ad serving platforms, Demand-Side Platform (DSP), Data Management Platform (DMP), analytics tools, and Application Programming Interface (API) integrations. [technology_budget >= 0]']
  third_party_vendor_budget numeric(18,2) [note: 'Portion of the total budget allocated to external vendor services, including research firms, data providers, freelancers, and specialized consultants. [third_party_vendor_budget >= 0]']
  total_actual_spend numeric(18,2) [note: 'Cumulative amount of budget that has been actually spent (invoiced and paid or accrued) against this project budget. [total_actual_spend >= 0]']
  total_approved_budget numeric(18,2) [not null, note: 'The total financial envelope approved for this project budget version. Represents the authorized spending limit. [total_approved_budget >= 0]']
  total_committed_spend numeric(18,2) [note: 'Cumulative amount of budget that has been committed through Purchase Orders (PO), Insertion Orders (IO), contracts, or other binding commitments, but not yet invoiced or paid. [total_committed_spend >= 0]']
  utilization_percentage numeric(5,2) [note: 'Percentage of the total approved budget that has been utilized (committed or spent). Calculated as ((total_committed_spend + total_actual_spend) / total_approved_budget) * 100. [utilization_percentage BETWEEN 0 AND 100]']
  version text [note: 'Version identifier for this budget iteration (e.g., v1.0, v2.1, 2024-Q1-Rev3). Enables tracking of budget revisions over the project lifecycle.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.resource_plan [note: 'Forward-looking resource demand plan for a project, capturing the planned allocation of agency talent and capacity across the project timeline. Stores project reference, planning period (week, sprint, month), role or discipline required, planned FTE count, planned hours, skill requirements, seniority level, department, cost rate applied, total planned cost, and plan version. Distinct from talent.resource_allocation (which records confirmed individual assignments) — this is the demand-side capacity plan used for staffing decisions and capacity forecasting at the project level.'] {
  resource_plan_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the resource plan record. Primary key for the resource plan entity.']
  contract_rate_card_id uuid [note: 'Foreign key linking to contract.contract_rate_card. Business justification: Agency resource plans are costed against negotiated rate cards. resource_plan has cost_rate, role_code, seniority_level that must align with contracted rates. This link enables accurate cost planning [→ crm_db.contract.contract_rate_card (not enforced)]']
  initiative_id uuid [note: 'Reference to the project for which this resource plan is created. Links to the project master entity. [→ project.initiative]']
  revised_from_resource_plan_id uuid [note: 'Self-referencing FK on resource_plan (revised_from_resource_plan_id) [→ project.resource_plan]']
  work_package_id uuid [note: 'Foreign key linking to project.work_package. Business justification: Resource plans are scoped not only at the initiative level but also at the work package (WBS node) level — e.g., \'we need 2 senior copywriters for the Creative Production work package.\' Adding work_pa [→ project.work_package]']
  allocation_priority text [note: 'The priority level for securing this resource allocation (critical, high, medium, low), used for capacity planning and resource conflict resolution. [allocation_priority IN (\'critical\', \'high\', \'medium\', \'low\')]']
  approval_date date [note: 'The date when this resource plan was approved by the project manager or resource manager.']
  approved_by text [note: 'The name or identifier of the person who approved this resource plan.']
  billable_flag boolean [not null, default: false, note: 'Indicates whether the planned hours for this resource are billable to the client (True) or non-billable/internal (False).']
  cost_rate numeric(10,2) [note: 'The internal cost rate applied per hour or per FTE for this role, used for capacity planning and project costing. [cost_rate >= 0]']
  cost_rate_currency char(3) [note: 'The three-letter ISO 4217 currency code for the cost rate (e.g., USD, EUR, GBP). [cost_rate_currency ~ \'^[A-Z]{3}$\']']
  department_code text [note: 'The code representing the department or cost center responsible for this resource allocation.']
  department_name text [note: 'The name of the department or cost center responsible for this resource allocation.']
  discipline text [note: 'The broad functional discipline or department to which the role belongs (creative, strategy, media, account management, production, analytics, technology, operations). [→ ref.discipline]']
  location_preference text [note: 'The preferred work location for this resource allocation (onsite, remote, hybrid, or any). [location_preference IN (\'onsite\', \'remote\', \'hybrid\', \'any\')]']
  notes text [note: 'Free-text notes or comments about this resource plan, including special requirements, constraints, or assumptions.']
  office_location text [note: 'The specific office or geographic location from which the resource is expected to work (e.g., New York, London, Remote).']
  plan_status text [not null, note: 'The current lifecycle status of the resource plan (draft, submitted for approval, approved, active, superseded by newer version, or cancelled). [plan_status IN (\'draft\', \'submitted\', \'approved\', \'active\', \'superseded\', \'cancelled\')]']
  plan_version text [note: 'Version identifier for the resource plan, enabling tracking of plan iterations and revisions over time (e.g., v1.0, v2.1, draft, final).']
  planned_fte numeric(5,2) [note: 'The planned Full-Time Equivalent (FTE) allocation for this role during the planning period. 1.0 represents one full-time resource; 0.5 represents half-time allocation.']
  planned_hours numeric(10,2) [note: 'The total number of hours planned for this role during the planning period. [planned_hours >= 0]']
  planning_period_end_date date [note: 'The end date of the planning period for which resources are being planned. [planning_period_end_date >= planning_period_start_date]']
  planning_period_start_date date [note: 'The start date of the planning period for which resources are being planned.']
  planning_period_type text [note: 'The time granularity used for resource planning (week, sprint, month, quarter, or project phase). [planning_period_type IN (\'week\', \'sprint\', \'month\', \'quarter\', \'phase\')]']
  role_code text [note: 'The standardized code representing the role or discipline required for this resource plan (e.g., ACD for Art Creative Director, CPY for Copywriter, STR for Strategist).']
  role_name text [note: 'The human-readable name of the role or discipline required (e.g., Art Director, Copywriter, Media Planner, Account Executive).']
  seniority_level text [note: 'The seniority or experience level required for the role (junior, mid-level, senior, lead, principal, director). [seniority_level IN (\'junior\', \'mid\', \'senior\', \'lead\', \'principal\', \'director\')]']
  skill_requirements text [note: 'Specific skills, competencies, or certifications required for the role (e.g., Adobe Creative Suite, Google Ads Certification, Salesforce CRM, Spanish language fluency).']
  total_planned_cost numeric(15,2) [note: 'The total planned cost for this resource allocation, calculated as planned hours multiplied by cost rate. [total_planned_cost >= 0]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table project.work_package [note: 'Work Breakdown Structure (WBS) node representing a discrete, manageable unit of work within a project. Captures WBS code, package name, description, parent package reference (enabling hierarchical decomposition), level in the WBS hierarchy, owning discipline or department (creative, media, strategy, production, PR), planned effort hours, actual effort hours, planned cost, actual cost, status, and completion percentage. Enables multi-level decomposition of project scope into deliverable-oriented components aligned to Workfront/Monday.com task groups.'] {
  work_package_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the work package within the Work Breakdown Structure (WBS). Primary key.']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Work packages require cost center assignment for labor cost allocation and profitability analysis by discipline. Enables accurate project costing and departmental charge-back in agency financial syste [→ erp_db.finance.cost_center (not enforced)]']
  initiative_id uuid [not null, note: 'Reference to the parent project or campaign engagement that this work package belongs to. [→ project.initiative]']
  parent_work_package_id uuid [note: 'Reference to the parent work package in the hierarchical WBS structure. Null for top-level packages. [→ project.work_package]']
  segment_id uuid [note: 'Foreign key linking to audience.segment. Business justification: Advertising work packages are scoped to specific audience segments (e.g., \'Build Retargeting Segment\', \'Activate Prospecting Audience\'). Project managers need this link to track segment-specific work [→ cdp_db.audience.segment (not enforced)]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Work packages decompose SOW scope. Agencies map WBS elements to SOW scope items for traceability, ensuring all contracted deliverables are planned and no out-of-scope work is executed without authoriz [→ crm_db.contract.sow (not enforced)]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: In advertising operations, specific work packages (e.g., creative production, media buying execution) are assigned to external vendors. Linking supplier_id to work_package enables vendor accountabilit [→ media_ops_db.vendor.supplier (not enforced)]']
  actual_cost numeric(15,2) [note: 'Actual cost incurred for this work package to date. Used for cost variance analysis and Earned Value Management (EVM). [actual_cost >= 0]']
  actual_effort_hours numeric(10,2) [note: 'Actual labor hours expended on this work package to date. Tracked from time entry systems for variance analysis. [actual_effort_hours >= 0]']
  actual_end_date date [note: 'Actual date when work on this package was completed. Null if not yet completed. [actual_end_date >= actual_start_date]']
  actual_start_date date [note: 'Actual date when work on this package commenced. Null if not yet started.']
  approval_status text [note: 'Current approval state of the work package deliverable. Tracks client or internal stakeholder sign-off. [approval_status IN (\'not_submitted\', \'pending_approval\', \'approved\', \'rejected\', \'approved_with_changes\')]']
  approved_by text [note: 'Name or identifier of the person who approved this work package. Null if not yet approved.']
  approved_date date [note: 'Date when this work package was formally approved. Null if not yet approved.']
  completion_percentage numeric(5,2) [note: 'Percentage of work completed for this package (0.00 to 100.00). Used for progress tracking and Earned Value (EV) calculation. [completion_percentage BETWEEN 0 AND 100]']
  currency_code char(3) [note: 'Three-letter ISO 4217 currency code for planned and actual cost amounts (e.g., USD, EUR, GBP). [currency_code ~ \'^[A-Z]{3}$\']']
  deliverable_type text [note: 'Classification of the primary deliverable produced by this work package (e.g., \'Creative Brief\', \'Media Plan\', \'Campaign Report\', \'Video Asset\'). [→ ref.deliverable_type]']
  discipline text [note: 'Primary agency discipline or department responsible for executing this work package (e.g., creative, media, strategy, production, PR). [→ ref.discipline]']
  is_billable boolean [not null, default: false, note: 'Indicates whether this work package is billable to the client (true) or non-billable internal work (false).']
  is_critical_path boolean [not null, default: false, note: 'Indicates whether this work package is on the project critical path. Delays to critical path items directly impact project completion date.']
  notes text [note: 'Free-form text field for additional context, instructions, risks, or issues related to this work package.']
  planned_cost numeric(15,2) [note: 'Budgeted cost for this work package including labor, materials, and other direct costs. Baseline for Earned Value Management (EVM). [planned_cost >= 0]']
  planned_effort_hours numeric(10,2) [note: 'Estimated total labor hours required to complete this work package. Used for resource capacity planning and baseline cost estimation. [planned_effort_hours >= 0]']
  planned_end_date date [note: 'Scheduled date when work on this package is planned to be completed. Used for baseline schedule tracking. [planned_end_date >= planned_start_date]']
  planned_start_date date [note: 'Scheduled date when work on this package is planned to begin. Used for baseline schedule tracking.']
  priority text [note: 'Business priority level assigned to this work package for resource allocation and scheduling decisions. [priority IN (\'critical\', \'high\', \'medium\', \'low\')]']
  wbs_code text [not null, note: 'Hierarchical alphanumeric code representing the work package position in the WBS (e.g., 1.2.3.1). Enables structured decomposition and rollup reporting. [wbs_code ~ \'^[A-Z0-9]+(\\.[A-Z0-9]+)*$\']']
  wbs_level integer [note: 'Numeric depth of this work package in the WBS hierarchy (1 = top level, 2 = second level, etc.). Enables level-based filtering and rollup.']
  work_package_description text [note: 'Detailed narrative describing the scope, deliverables, and objectives of this work package. Provides context for resource planning and execution.']
  work_package_name text [not null, note: 'Short, descriptive name of the work package that clearly identifies the deliverable or work scope (e.g., \'Creative Concept Development\', \'Media Buy Execution\').']
  work_package_status text [not null, note: 'Current lifecycle status of the work package indicating progress and execution state. [work_package_status IN (\'not_started\', \'in_progress\', \'on_hold\', \'completed\', \'cancelled\', \'under_review\')]']
  work_package_type text [note: 'Classification of the work package within the WBS structure (deliverable-oriented, milestone, phase, task group, or control account). [work_package_type IN (\'deliverable\', \'milestone\', \'phase\', \'task_group\', \'control_account\')]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

