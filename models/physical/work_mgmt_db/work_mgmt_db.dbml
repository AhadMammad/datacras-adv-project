// work_mgmt_db: Adobe Workfront + DAM. Generated by advgen from the pinned Advertising MVM; do not edit by hand. Regenerate with `uv run advgen build`.

Project work_mgmt_db {
  database_type: 'PostgreSQL'
  Note: 'Agency projects, work breakdown, tasks, time entries, and the creative production lifecycle from brief to approved asset.'
}

Table ref.approval_status [note: 'Code set. Values: not_submitted, pending_internal, pending_client, approved_internal, approved_client, rejected, conditional'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

