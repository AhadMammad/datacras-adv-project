  audience.behavioral_profile
  audience.demographic_profile
  audience.persona
  audience.segment
  audience.taxonomy
  audience.activation
  audience.lookalike_model
  audience.segment_membership
  audience.suppression_list
}

TableGroup ref {
  ref.employment_category
  ref.education_level
  ref.income_tier
  ref.vals_segment
  ref.algorithm_type
  ref.membership_source
}
