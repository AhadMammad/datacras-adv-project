// cdp_db: Customer Data Platform / DMP. Generated by advgen from the pinned Advertising MVM; do not edit by hand. Regenerate with `uv run advgen build`.

Project cdp_db {
  database_type: 'PostgreSQL'
  Note: 'Audience taxonomy, segments, profiles, personas, lookalike models, segment membership, suppression lists and activations to platforms.'
}

Table ref.employment_category [note: 'Code set. Values: employed_full_time, employed_part_time, self_employed, unemployed, retired, student, undisclosed'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table ref.education_level [note: 'Code set. Values: less_than_high_school, high_school, some_college, associate, bachelor, graduate, postgraduate'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table ref.income_tier [note: 'Code set. Values: <25K, 25K-50K, 50K-75K, 75K-100K, 100K-150K, 150K-250K, 250K+'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table ref.vals_segment [note: 'Code set. Values: innovators, thinkers, achievers, experiencers, believers, strivers, makers, survivors'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table ref.algorithm_type [note: 'Code set. Values: cosine_similarity, gradient_boosting, neural_network, random_forest, logistic_regression, collaborative_filtering, k_nearest_neighbors, decision_tree, support_vector_machine'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table ref.membership_source [note: 'Code set. Values: first_party, second_party, third_party, modeled, lookalike, behavioral, contextual'] {
  code text [pk]
  label text [not null]
  description text
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table audience.behavioral_profile [note: 'Behavioral audience profile capturing observed digital and offline behaviors — including browsing categories, purchase history signals, app usage patterns, content consumption categories, search intent signals, recency/frequency/monetary (RFM) scores, and cross-device activity. Sourced from DMP/CDP integrations, The Trade Desk audience data, and first-party behavioral signals. Used for behavioral targeting and lookalike modeling.'] {
  behavioral_profile_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the behavioral audience profile record. Primary key.']
  primary_behavioral_audience_segment_id uuid [not null, note: 'Reference to the parent audience segment this behavioral profile belongs to. [→ audience.segment]']
  primary_taxonomy_id uuid [note: 'Foreign key linking to audience.taxonomy. Business justification: behavioral_profile has browsing_category_primary and browsing_category_secondary (strings). audience_taxonomy provides standardized audience classification. Adding primary_taxonomy_id (FK to audience_ [→ audience.taxonomy]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Behavioral profiles are built from data sourced from third-party data suppliers (DMPs, data brokers). data_source_description is a denormalization signal. Supplier FK enables data lineage tracking, GD [→ media_ops_db.vendor.supplier (not enforced)]']
  tertiary_behavioral_lookalike_seed_segment_audience_segment_id uuid [note: 'Reference to the seed audience segment used to generate this lookalike behavioral profile, if applicable. [→ audience.segment]']
  app_usage_pattern text [note: 'Description of observed mobile app usage patterns (e.g., \'Gaming Apps\', \'Shopping Apps\', \'News Apps\', \'Social Media Apps\').']
  brand_affinity_category text [note: 'Category of brands or products the user has shown affinity toward based on observed behavior (e.g., \'Luxury Brands\', \'Eco-Friendly Products\', \'Tech Gadgets\').']
  browsing_category_primary text [note: 'The primary content category observed in the user\'s browsing behavior (e.g., \'Automotive\', \'Travel\', \'Finance\', \'Health & Wellness\').']
  browsing_category_secondary text [note: 'The secondary content category observed in the user\'s browsing behavior, indicating additional interests.']
  consent_status text [note: 'Privacy consent status for behavioral data collection and usage, ensuring compliance with GDPR, CCPA, and other privacy regulations. [consent_status IN (\'granted\', \'denied\', \'pending\', \'withdrawn\', \'not_required\')]']
  consent_timestamp timestamptz [note: 'Timestamp when consent was granted or last updated for this behavioral profile.']
  content_consumption_category text [note: 'Category of content consumed by the user (e.g., \'Video\', \'Articles\', \'Podcasts\', \'Social Media\').']
  cross_device_activity_flag boolean [not null, default: false, note: 'Indicates whether the behavioral profile includes cross-device activity tracking and identity resolution.']
  data_retention_expiry_date date [note: 'Date when this behavioral profile data must be purged or anonymized per privacy regulations and data retention policies.']
  day_of_week_preference text [note: 'Observed preference for day of week when the user is most active online. [day_of_week_preference IN (\'weekday\', \'weekend\', \'mixed\')]']
  device_type_primary text [note: 'The primary device type observed in the user\'s digital behavior. [device_type_primary IN (\'desktop\', \'mobile\', \'tablet\', \'ctv\', \'ott\', \'unknown\')]']
  engagement_level text [note: 'Overall engagement level classification based on interaction frequency, depth, and duration. [engagement_level IN (\'very_high\', \'high\', \'medium\', \'low\', \'very_low\')]']
  frequency_score integer [note: 'Frequency component of RFM scoring model, indicating how often the user exhibits the behavior (scale 1-5, 5 being most frequent).']
  geographic_behavior_pattern text [note: 'Description of observed geographic or location-based behavior patterns (e.g., \'Urban Commuter\', \'Frequent Traveler\', \'Suburban Resident\').']
  last_observed_behavior_date date [note: 'Date when the most recent behavioral signal was observed for this profile.']
  lookalike_similarity_score numeric(5,2) [note: 'Similarity score (0.00 to 100.00) indicating how closely this profile matches the seed segment for lookalike modeling.']
  monetary_score integer [note: 'Monetary component of RFM scoring model, indicating the value associated with the user\'s behavior (scale 1-5, 5 being highest value).']
  notes text [note: 'Free-text notes or comments about this behavioral profile for internal reference and documentation.']
  privacy_jurisdiction text [note: 'Primary privacy jurisdiction applicable to this behavioral profile (e.g., \'EU\', \'California\', \'Global\').']
  profile_creation_date date [note: 'Date when this behavioral profile was first created in the system.']
  profile_last_updated_timestamp timestamptz [note: 'Timestamp when this behavioral profile was last updated with new behavioral signals or attributes.']
  profile_name text [not null, note: 'Human-readable name or label for this behavioral profile (e.g., \'High-Intent Auto Shoppers\', \'Frequent Travelers\').']
  profile_quality_score numeric(5,2) [note: 'Quality score (0.00 to 100.00) indicating the accuracy, completeness, and reliability of the behavioral profile data.']
  profile_reach_estimate bigint [note: 'Estimated number of unique users or devices matching this behavioral profile, used for campaign planning and media buying. [profile_reach_estimate >= 0]']
  profile_status text [not null, note: 'Current lifecycle status of the behavioral profile indicating availability for targeting. [profile_status IN (\'active\', \'inactive\', \'archived\', \'pending_review\', \'deprecated\')]']
  profile_type text [note: 'Classification of the behavioral profile based on data source and construction method. [profile_type IN (\'first_party\', \'second_party\', \'third_party\', \'modeled\', \'lookalike\')]']
  purchase_intent_signal text [note: 'Derived signal indicating the likelihood of purchase behavior based on observed actions (e.g., cart additions, product page views, price comparisons). [purchase_intent_signal IN (\'high\', \'medium\', \'low\', \'none\')]']
  recency_score integer [note: 'Recency component of RFM (Recency, Frequency, Monetary) scoring model, indicating how recently the user exhibited the behavior (scale 1-5, 5 being most recent).']
  search_intent_keywords text [note: 'Comma-separated list of observed search keywords or phrases indicating user intent and interests.']
  seasonal_behavior_pattern text [note: 'Description of observed seasonal or cyclical behavior patterns (e.g., \'Holiday Shopper\', \'Back-to-School\', \'Summer Traveler\').']
  targeting_eligibility_flag boolean [not null, default: false, note: 'Indicates whether this behavioral profile is currently eligible for use in campaign targeting based on quality, consent, and compliance checks.']
  time_of_day_preference text [note: 'Observed preference for time of day when the user is most active online. [time_of_day_preference IN (\'morning\', \'afternoon\', \'evening\', \'night\', \'mixed\')]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table audience.demographic_profile [note: 'Structured demographic attribute set for audience definitions — including age band, gender, household income tier, education level, marital status, parental status, geographic region, DMA (Designated Market Area), language, ethnicity (where legally permissible), and employment category. Sourced from Nielsen, Comscore, and first-party CRM data. Serves as the demographic dimension for segment qualification and targeting criteria.'] {
  demographic_profile_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the demographic profile record. Primary key for the demographic profile entity.']
  primary_demographic_audience_segment_id uuid [note: 'External segment identifier from the Data Management Platform (DMP) system. Used for DMP integration and cross-platform targeting. [→ audience.segment]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Demographic profiles are sourced from third-party data vendors (Experian, Acxiom, etc.). Supplier FK is required for data lineage, vendor cost attribution, GDPR data processor tracking, and data quali [→ media_ops_db.vendor.supplier (not enforced)]']
  taxonomy_id uuid [note: 'Foreign key linking to audience.taxonomy. Business justification: audience_taxonomy provides standardized audience classification categories aligned to IAB Audience Taxonomy. demographic_profile should be classified using this standardized taxonomy for consistency a [→ audience.taxonomy]']
  age_band text [note: 'Age range classification for the demographic profile. Standard age cohorts used for audience segmentation and targeting. [age_band IN (\'18-24\', \'25-34\', \'35-44\', \'45-54\', \'55-64\', \'65+\')]']
  children_age_range text [note: 'Age range of children in household (e.g., \'0-5\', \'6-12\', \'13-17\'). Used for family and parenting-focused targeting. Null if parental_status is non_parent.']
  consent_date date [note: 'Date when consent was obtained for use of this demographic data. Required for GDPR and CCPA audit trails.']
  consent_expiration_date date [note: 'Date when consent expires and data can no longer be used for targeting. Null if consent does not expire.']
  consent_status text [note: 'Privacy consent status for use of this demographic data in targeting. Critical for GDPR and CCPA compliance. [consent_status IN (\'consented\', \'not_consented\', \'pending\', \'withdrawn\')]']
  country_code char(3) [note: 'Three-letter ISO country code (e.g., \'USA\', \'CAN\', \'GBR\'). Used for international campaign targeting and compliance. [country_code ~ \'^[A-Z]{3}$\']']
  dma_code text [note: 'Nielsen Designated Market Area code representing the geographic television market. Critical for broadcast and OOH media planning.']
  dma_name text [note: 'Human-readable name of the Nielsen DMA (e.g., \'New York\', \'Los Angeles\', \'Chicago\'). Used for media planning and reporting.']
  education_level text [note: 'Highest level of education attained. Used for audience segmentation and targeting strategies. [education_level IN (\'high_school\', \'some_college\', \'bachelors\', \'masters\', \'doctorate\', \'other\')]']
  employment_category text [note: 'Employment status classification. Used for socioeconomic and lifestyle-based audience segmentation. [→ ref.employment_category]']
  estimated_population_size bigint [note: 'Estimated number of individuals matching this demographic profile. Used for reach estimation and media planning. [estimated_population_size >= 0]']
  ethnicity text [note: 'Ethnic or cultural background classification where legally permissible and consented. Used for culturally relevant targeting. Subject to GDPR, CCPA, and local privacy regulations.']
  gender text [note: 'Gender classification for the demographic profile. Used for audience targeting and campaign personalization. [gender IN (\'male\', \'female\', \'non-binary\', \'undisclosed\')]']
  geographic_region text [note: 'Broad geographic region classification within the country. Used for regional media planning and geo-targeting. [geographic_region IN (\'northeast\', \'southeast\', \'midwest\', \'southwest\', \'west\', \'other\')]']
  homeownership_status text [note: 'Indicates whether the individual owns or rents their residence. Used for real estate, home services, and financial product targeting. [homeownership_status IN (\'owner\', \'renter\', \'undisclosed\')]']
  household_income_tier text [note: 'Household income bracket classification. Used for socioeconomic targeting and media planning. Sourced from Nielsen, Comscore, and first-party CRM data. [household_income_tier IN (\'under_25k\', \'25k_50k\', \'50k_75k\', \'75k_100k\', \'100k_150k\', \'over_150k\')]']
  household_size integer [note: 'Number of individuals in the household. Used for household composition analysis and targeting. [household_size >= 0]']
  last_verified_date date [note: 'Date when the demographic profile data was last verified or updated. Used for data freshness assessment.']
  marital_status text [note: 'Marital status classification for the demographic profile. Used for household-based targeting and lifestyle segmentation. [marital_status IN (\'single\', \'married\', \'divorced\', \'widowed\', \'undisclosed\')]']
  occupation_category text [note: 'Broad occupational category (e.g., \'Professional\', \'Management\', \'Service\', \'Sales\', \'Technical\'). Used for B2B and professional targeting.']
  parental_status text [note: 'Indicates whether the individual is a parent. Used for family-oriented campaign targeting. [parental_status IN (\'parent\', \'non_parent\', \'undisclosed\')]']
  postal_code text [note: 'Postal code (ZIP code in U.S.) for geographic targeting and localization. Used for hyper-local campaign targeting.']
  primary_language text [note: 'Primary language spoken by the demographic segment (e.g., \'English\', \'Spanish\', \'Mandarin\'). Used for creative localization and media channel selection.']
  profile_code text [not null, note: 'Standardized code or identifier used across systems to reference this demographic profile (e.g., \'DEM-001\', \'PROF-URBAN-25-34\').']
  profile_confidence_score numeric(5,2) [note: 'Confidence score (0-100) indicating the accuracy and completeness of the demographic profile data. Used for data quality assessment and targeting precision.']
  profile_description text [note: 'Detailed textual description of the demographic profile, including key characteristics and targeting use cases.']
  profile_name text [not null, note: 'Human-readable name or label for this demographic profile segment (e.g., \'Affluent Urban Millennials\', \'Suburban Families\').']
  profile_status text [note: 'Current lifecycle status of the demographic profile. Indicates whether the profile is available for targeting. [profile_status IN (\'active\', \'inactive\', \'archived\', \'pending_review\')]']
  psychographic_segment text [note: 'Psychographic or lifestyle segment classification (e.g., \'Early Adopters\', \'Value Seekers\', \'Luxury Enthusiasts\'). Used for behavioral and attitudinal targeting.']
  urbanicity text [note: 'Classification of residential area type. Used for lifestyle-based targeting and media channel selection. [urbanicity IN (\'urban\', \'suburban\', \'rural\')]']
  vehicle_ownership text [note: 'Indicates whether the individual owns a vehicle. Used for automotive, insurance, and transportation-related targeting. [vehicle_ownership IN (\'owns_vehicle\', \'no_vehicle\', \'undisclosed\')]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (profile_code) [unique]
  }
}

Table audience.persona [note: 'Synthesized audience persona profiles representing archetypal target audience groups for campaign planning and creative strategy. Captures persona name, narrative description, demographic summary, psychographic traits, media consumption habits, purchase intent signals, pain points, motivations, and associated brand affinity scores. Used by account teams and strategists to align creative briefs and media plans to defined audience archetypes.'] {
  persona_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the audience persona profile. Primary key.']
  behavioral_profile_id uuid [note: 'Foreign key linking to audience.behavioral_profile. Business justification: Personas currently have digital_behavior_profile (string) and related behavioral attributes. behavioral_profile is a structured, reusable behavioral profile with detailed behavioral data. Normalizing [→ audience.behavioral_profile]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Consumer personas are defined per brand for creative strategy, messaging frameworks, and brand planning. Brand planners and strategists need to retrieve all personas associated with a specific brand. [→ crm_db.client.brand (not enforced)]']
  demographic_profile_id uuid [note: 'Foreign key linking to audience.demographic_profile. Business justification: Personas currently have embedded demographic attributes (age_range_min/max, gender_profile, income_bracket, education_level, geographic_focus, household_composition). demographic_profile is a structur [→ audience.demographic_profile]']
  primary_audience_segment_id uuid [note: 'Foreign key linking to audience.segment. Business justification: A persona is a synthesized archetypal audience profile that is built from and represents one or more audience segments. The primary_audience_segment_id FK establishes the foundational segment from whi [→ audience.segment]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Persona development is a scoped deliverable in advertising SOWs — agencies are contracted to build specific personas for client campaigns. Linking persona to sow enables SOW deliverable tracking, bill [→ crm_db.contract.sow (not enforced)]']
  taxonomy_id uuid [note: 'Foreign key linking to audience.taxonomy. Business justification: A persona represents an archetypal audience group and should be classified under the standardized IAB Audience Taxonomy for cross-platform consistency, DMP/CDP integration alignment, and regulatory re [→ audience.taxonomy]']
  ccpa_opt_out_eligible boolean [not null, default: false, note: 'Indicates whether individuals matching this persona have CCPA opt-out rights for data sale.']
  cdp_audience_key text [note: 'Reference key for this persona in the Customer Data Platform for cross-channel activation.']
  cltv_estimate numeric(15,2) [note: 'Projected lifetime value in USD for customers matching this persona profile.']
  consent_compliant_flag boolean [not null, default: false, note: 'Indicates whether this persona profile is built exclusively from privacy-compliant, consented data sources.']
  content_preferences text [note: 'Types of content and messaging styles that resonate with this persona (e.g., \'Educational\', \'Humorous\', \'Inspirational\').']
  conversion_propensity numeric(5,2) [note: 'Likelihood score (0-100) that this persona will convert based on historical campaign performance.']
  data_source_type text [note: 'Classification of the primary data source used to construct this persona profile. [data_source_type IN (\'first_party\', \'second_party\', \'third_party\', \'synthesized\')]']
  dmp_segment_ids text [note: 'Comma-separated list of DMP segment IDs that map to this persona for programmatic activation.']
  estimated_reach bigint [note: 'Estimated total addressable audience size for this persona across all available channels. [estimated_reach >= 0]']
  gdpr_lawful_basis text [note: 'Legal basis under GDPR for processing personal data associated with this persona. [gdpr_lawful_basis IN (\'consent\', \'legitimate_interest\', \'contract\', \'legal_obligation\', \'not_applicable\')]']
  last_validated_date date [note: 'Date when this persona profile was last reviewed and validated by strategy or account teams.']
  narrative_description text [note: 'Rich narrative description of the persona, including lifestyle, values, and behavioral characteristics used by creative teams.']
  pain_points text [note: 'Key challenges, frustrations, or unmet needs that this persona experiences, used to inform messaging strategy.']
  persona_code text [not null, note: 'Short alphanumeric code used for quick reference in campaign planning and media buying systems. [persona_code ~ \'^[A-Z0-9_]{3,20}$\']']
  persona_name text [not null, note: 'The archetypal name or label assigned to this persona (e.g., \'Tech-Savvy Millennial\', \'Budget-Conscious Parent\').']
  persona_status text [not null, note: 'Current lifecycle status of the persona profile. [persona_status IN (\'active\', \'inactive\', \'draft\', \'archived\', \'under_review\')]']
  preferred_channels text [note: 'Comma-separated list of most effective marketing channels for reaching this persona (e.g., \'Social Media, CTV, Digital Display\').']
  social_media_platforms text [note: 'Comma-separated list of social media platforms where this persona is most active (e.g., \'Facebook, Instagram, TikTok\').']
  usage_count integer [note: 'Number of campaigns or media plans that have actively targeted this persona. [usage_count >= 0]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (persona_code) [unique]
  }
}

Table audience.segment [note: 'Master record and SSOT for all audience segments — first-party, second-party, and third-party — used across campaigns. Captures segment name, type (behavioral, demographic, psychographic, contextual, lookalike), data source (1P/2P/3P), segment size, creation method (rules-based, ML-modeled, imported), activation status, refresh cadence, expiry date, IAB taxonomy classification, and owning team. Embeds full qualification criteria spanning demographic attributes (age band, gender, income tier, DMA, education, marital/parental status, language), behavioral signals (browsing categories, purchase history, RFM scores, app usage, cross-device activity, search intent, content consumption), and psychographic dimensions (VALS, brand affinity, lifestyle segments, interest taxonomies, purchase motivations, personality indicators, media attitudes). Qualification criteria are sourced from Nielsen, Comscore, first-party CRM, DMP/CDP integrations, survey data, and social listening. SSOT for all audience segment definitions, targeting rules, and profile-level qualification logic in the advertising platform.'] {
  segment_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the audience segment. Primary key.']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Audience segment data acquisition and maintenance costs are allocated to cost centers for internal P&L reporting and chargeback. Advertising agencies track which department owns each segment. \'owning_ [→ erp_db.finance.cost_center (not enforced)]']
  data_supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Audience segments are frequently sourced from or enriched by third-party data suppliers. Supplier FK on audience_segment enables data sourcing cost attribution, vendor performance evaluation for data [→ media_ops_db.vendor.supplier (not enforced)]']
  master_agreement_id uuid [note: 'Foreign key linking to contract.agreement. Business justification: Audience segments often governed by master agreements defining data usage rights, licensing terms, geographic restrictions, and activation permissions. Critical for compliance tracking, data rights ma [→ crm_db.contract.agreement (not enforced)]']
  sow_id uuid [note: 'Foreign key linking to contract.sow. Business justification: Campaign-specific custom segments are frequently defined as SOW deliverables with specific build criteria, acceptance thresholds, and delivery timelines. Essential for scope validation, deliverable tr [→ crm_db.contract.sow (not enforced)]']
  taxonomy_id uuid [note: 'Foreign key linking to audience.taxonomy. Business justification: Segments should be formally classified using the standardized audience taxonomy (aligned to IAB Audience Taxonomy per audience_taxonomy product description). The segment table currently has \'iab_taxon [→ audience.taxonomy]']
  activation_status text [note: 'Indicates whether the segment has been pushed to DSPs, ad servers, or activation platforms for live campaign use. [activation_status IN (\'activated\', \'not_activated\', \'pending_activation\')]']
  age_band_max integer [note: 'Upper bound of the age range for demographic qualification (e.g., 24 for 18-24 age band). Nullable if age is not a qualification criterion.']
  age_band_min integer [note: 'Lower bound of the age range for demographic qualification (e.g., 18 for 18-24 age band). Nullable if age is not a qualification criterion.']
  app_usage_flag boolean [not null, default: false, note: 'Indicates whether segment qualification includes mobile app usage or in-app behavior signals.']
  audience_segment_description text [note: 'Detailed business description of the segment purpose, target audience characteristics, and intended use cases for campaign targeting.']
  audience_segment_name text [not null, note: 'Human-readable name of the audience segment used for identification and campaign targeting.']
  audience_segment_status text [not null, note: 'Current lifecycle status of the segment: active (available for targeting), inactive (paused), draft (under development), archived (historical reference), or expired (past validity period). [audience_segment_status IN (\'active\', \'inactive\', \'draft\', \'archived\', \'expired\')]']
  audience_segment_type text [note: 'Classification of the segment based on the primary targeting methodology: behavioral (actions/browsing), demographic (age/gender/income), psychographic (attitudes/values), contextual (content affinity), lookalike (modeled similarity), or geographic (location-based). [audience_segment_type IN (\'behavioral\', \'demographic\', \'psychographic\', \'contextual\', \'lookalike\', \'geographic\')]']
  brand_affinity_list text [note: 'Comma-separated list of brands that segment members have shown affinity toward through engagement, purchase, or social signals. Nullable if brand affinity is not a qualification criterion.']
  browsing_categories text [note: 'Comma-separated list of IAB content categories or site categories that segment members have browsed (e.g., IAB1 for Automotive, IAB3 for Business). Nullable if browsing behavior is not a qualification criterion.']
  ccpa_compliant_flag boolean [not null, default: false, note: 'Indicates whether the segment meets CCPA requirements for consumer opt-out rights and data sale restrictions.']
  consent_status text [note: 'Privacy consent status for segment members under GDPR, CCPA, or other privacy regulations: consented (explicit opt-in), not_consented (no consent), pending (consent requested), or withdrawn (consent revoked). [consent_status IN (\'consented\', \'not_consented\', \'pending\', \'withdrawn\')]']
  content_consumption_topics text [note: 'Comma-separated list of content topics or themes consumed by segment members (e.g., \'sports\', \'finance\', \'travel\'). Nullable if content affinity is not a qualification criterion.']
  creation_method text [note: 'Methodology used to build the segment: rules-based (Boolean logic), ML-modeled (algorithmic clustering/propensity), imported (from external platform), survey-derived (research panel), or manual (curated list). [creation_method IN (\'rules_based\', \'ml_modeled\', \'imported\', \'survey_derived\', \'manual\')]']
  cross_device_flag boolean [not null, default: false, note: 'Indicates whether segment uses cross-device identity resolution to track users across desktop, mobile, tablet, and CTV.']
  data_source_tier text [note: 'Origin tier of the segment data: first-party (owned CRM/web/app data), second-party (partner-shared data), or third-party (purchased from data providers). [data_source_tier IN (\'first_party\', \'second_party\', \'third_party\')]']
  dma_codes text [note: 'Comma-separated list of Nielsen DMA codes (e.g., 501 for New York) used for geographic targeting. Nullable if geography is not a qualification criterion.']
  education_level text [note: 'Highest education attainment level used for demographic qualification (e.g., high school, bachelor, graduate). Nullable if education is not a qualification criterion. [→ ref.education_level]']
  effective_date date [note: 'Date when the segment becomes available for targeting and activation.']
  expiry_date date [note: 'Date when the segment is no longer valid for targeting, either due to data staleness, consent expiration, or campaign end. Nullable for evergreen segments.']
  external_code text [note: 'External identifier or code used by DSPs, DMPs, CDPs, and third-party platforms to reference this segment.']
  gdpr_compliant_flag boolean [not null, default: false, note: 'Indicates whether the segment meets GDPR requirements for lawful processing, consent, and data subject rights.']
  gender text [note: 'Gender demographic filter applied to segment qualification. Nullable if gender is not a qualification criterion. [gender IN (\'male\', \'female\', \'non_binary\', \'all\', \'unknown\')]']
  income_tier text [note: 'Household income bracket or tier used for demographic qualification (e.g., <50K, 50K-100K, 100K+). Nullable if income is not a qualification criterion. [→ ref.income_tier]']
  interest_taxonomy text [note: 'Comma-separated list of interest categories or hobbies (e.g., \'fitness\', \'gaming\', \'cooking\') used for psychographic qualification. Nullable if interests are not a qualification criterion.']
  language_preference text [note: 'Primary language preference for segment members (ISO 639-1 codes: EN, ES, FR, etc.). Nullable if language is not a qualification criterion.']
  lifestyle_segment text [note: 'Lifestyle or life-stage classification (e.g., \'young professionals\', \'empty nesters\', \'urban millennials\') used for psychographic qualification. Nullable if lifestyle is not a qualification criterion.']
  marital_status text [note: 'Marital status demographic filter applied to segment qualification. Nullable if marital status is not a qualification criterion. [marital_status IN (\'single\', \'married\', \'divorced\', \'widowed\', \'all\', \'unknown\')]']
  parental_status text [note: 'Indicates whether segment targets parents, non-parents, or all. Nullable if parental status is not a qualification criterion. [parental_status IN (\'parent\', \'non_parent\', \'all\', \'unknown\')]']
  purchase_history_flag boolean [not null, default: false, note: 'Indicates whether segment qualification includes past purchase behavior from CRM or e-commerce data.']
  refresh_cadence text [note: 'Frequency at which segment membership is recalculated and updated: real-time (streaming), hourly, daily, weekly, monthly, or static (one-time build). [refresh_cadence IN (\'real_time\', \'hourly\', \'daily\', \'weekly\', \'monthly\', \'static\')]']
  rfm_score text [note: 'RFM segmentation score (e.g., 555 for best customers, 111 for low-value) used for behavioral qualification. Nullable if RFM is not a qualification criterion.']
  search_intent_keywords text [note: 'Comma-separated list of search keywords or intent signals used for behavioral qualification (e.g., \'luxury cars\', \'mortgage refinance\'). Nullable if search intent is not a qualification criterion.']
  size bigint [note: 'Total count of unique users, devices, or households currently qualifying for this segment. [size >= 0]']
  vals_segment text [note: 'VALS psychographic segmentation classification (e.g., Innovators, Thinkers, Achievers, Experiencers) used for psychographic qualification. Nullable if VALS is not a qualification criterion. [→ ref.vals_segment]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table audience.taxonomy [note: 'Reference taxonomy for standardized audience classification categories — aligned to IAB Audience Taxonomy v1.1 and custom agency extensions. Captures taxonomy node ID, parent node, category name, category level (tier 1/2/3), IAB standard code, description, applicable data types (behavioral/demographic/contextual), and active status. Provides the controlled vocabulary for consistent segment classification across campaigns, platforms, and reporting.'] {
  taxonomy_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the audience taxonomy node. Primary key for the audience taxonomy reference structure.']
  parent_taxonomy_id uuid [note: 'Reference to the parent node in the taxonomy hierarchy. Null for top-level (tier 1) categories. Enables hierarchical navigation and roll-up reporting. [→ audience.taxonomy]']
  primary_replacement_taxonomy_id uuid [note: 'Reference to the taxonomy node that replaces this deprecated category. Null for active categories or deprecated categories without direct replacement. Enables automated migration of historical segments. [→ audience.taxonomy]']
  applicable_platforms text [note: 'Comma-separated list of digital platforms and channels where this taxonomy category is applicable (e.g., display, video, social, search, CTV, DOOH). Guides media planners on appropriate channel selection.']
  average_cpm_usd numeric(12,2) [note: 'Average cost per thousand impressions in US dollars for media buys targeting this audience category. Based on historical campaign data and current market rates. Used for budget planning and cost estimation. [average_cpm_usd >= 0]']
  category_description text [note: 'Detailed description of the audience category, including defining characteristics, typical behaviors, and use cases. Provides guidance for media planners and data analysts on appropriate segment application.']
  category_name text [not null, note: 'Human-readable name of the audience taxonomy category. Used in campaign planning interfaces, reporting dashboards, and client presentations.']
  cdp_integration_enabled boolean [not null, default: false, note: 'Indicates whether this taxonomy category is integrated with Customer Data Platform for unified customer profile enrichment and personalization. True enables real-time audience orchestration across owned channels.']
  comscore_compatible boolean [not null, default: false, note: 'Indicates whether this taxonomy category can be mapped to Comscore digital audience measurement segments for cross-platform analytics and validation. True enables independent third-party audience verification.']
  consent_required boolean [not null, default: false, note: 'Indicates whether explicit user consent is required under GDPR, CCPA, or other privacy regulations before using this audience category for targeting. True requires documented consent; false indicates legitimate interest or non-regulated data.']
  cpm_last_updated_date date [note: 'Date when the average CPM value was last refreshed from campaign performance data and market intelligence. Indicates pricing data freshness.']
  data_source_type text [note: 'Classification of the data source origin for this audience category. First-party data is owned by the advertiser, second-party is partner-shared, third-party is purchased from data providers. Deterministic uses known identifiers; probabilistic uses inferred signals. [data_source_type IN (\'first_party\', \'second_party\', \'third_party\', \'deterministic\', \'probabilistic\')]']
  data_type text [note: 'Primary data classification type for this audience category. Indicates the source and nature of the audience signal used for segmentation and targeting. [data_type IN (\'behavioral\', \'demographic\', \'contextual\', \'psychographic\', \'geographic\', \'technographic\')]']
  deprecation_reason text [note: 'Explanation for why this taxonomy category was deprecated or retired. Includes migration guidance to replacement categories. Null for active categories.']
  dmp_integration_enabled boolean [not null, default: false, note: 'Indicates whether this taxonomy category is integrated with the agency Data Management Platform for audience activation and cross-platform targeting. True enables automated segment sync to DSPs and SSPs.']
  dsp_activation_enabled boolean [not null, default: false, note: 'Indicates whether this taxonomy category is available for programmatic activation via Demand-Side Platforms such as The Trade Desk. True enables real-time bidding and automated audience targeting in programmatic campaigns.']
  effective_end_date date [note: 'Date when this taxonomy category was deprecated or retired. Null for currently active categories. Supports historical campaign analysis and taxonomy lifecycle management. [effective_end_date >= effective_start_date]']
  effective_start_date date [note: 'Date when this taxonomy category became available for use. Supports historical analysis and version control of taxonomy evolution.']
  estimated_reach bigint [note: 'Estimated total addressable audience size (unique users or devices) for this taxonomy category across all integrated platforms. Updated periodically based on DMP and CDP data. Used for media planning and feasibility assessment. [estimated_reach >= 0]']
  exclusion_categories text [note: 'Comma-separated list of taxonomy codes that should be excluded when this category is used, to prevent audience overlap or conflicting targeting logic. Enforces mutually exclusive segment rules.']
  iab_standard_code text [note: 'Official IAB Audience Taxonomy standard code for this category. Null for custom agency extensions not covered by IAB standard. Enables industry-standard audience classification and cross-publisher comparison. [iab_standard_code ~ \'^(IAB[0-9]{1,4}(-[0-9]{1,4})?)?$\']']
  is_active boolean [not null, default: false, note: 'Indicates whether this taxonomy category is currently active and available for use in campaign planning and targeting. False indicates deprecated or sunset categories that should not be used in new campaigns.']
  last_reviewed_date date [note: 'Date when this taxonomy category was last reviewed for accuracy, relevance, and compliance. Supports taxonomy governance and quality assurance processes.']
  minimum_segment_size integer [note: 'Minimum number of unique users or devices required for this audience category to be activated in campaigns. Enforces privacy thresholds and prevents re-identification risk. Typically set to 1000+ for GDPR compliance and platform minimums. [minimum_segment_size >= 0]']
  nielsen_compatible boolean [not null, default: false, note: 'Indicates whether this taxonomy category can be mapped to Nielsen audience measurement segments for GRP and TRP calculation. True enables cross-platform reach and frequency planning using Nielsen Ad Intel data.']
  path text [note: 'Full hierarchical path from root to this node, using forward-slash delimiter (e.g., Demographics/Age/18-24). Enables breadcrumb navigation and full-path filtering in reporting tools.']
  privacy_classification text [note: 'Privacy sensitivity level of the audience data in this category. Non-PII contains no personal identifiers, pseudonymous uses hashed or tokenized IDs, PII-based includes direct identifiers, sensitive includes special category data under GDPR Article 9. [privacy_classification IN (\'non_pii\', \'pseudonymous\', \'pii_based\', \'sensitive\')]']
  reach_last_updated_date date [note: 'Date when the estimated reach value was last refreshed from source systems. Indicates data freshness for media planning decisions.']
  taxonomy_code text [not null, note: 'Unique alphanumeric code identifying this taxonomy node. Used for system integration and cross-platform mapping. Follows agency naming convention. [taxonomy_code ~ \'^[A-Z0-9_]{2,20}$\']']
  taxonomy_level integer [note: 'Hierarchical tier level of this taxonomy node. Tier 1 represents top-level categories, tier 2 represents sub-categories, tier 3 represents granular segments. Supports drill-down analysis and hierarchical reporting.']
  usage_guidelines text [note: 'Best practice guidance and restrictions for using this audience category in campaigns. Includes recommended use cases, exclusion scenarios, and compliance considerations. Supports media planners and account teams in appropriate segment application.']
  version_number text [note: 'Version identifier for this taxonomy node, following semantic versioning convention (major.minor.patch). Tracks taxonomy evolution and enables version-specific reporting and analysis. [version_number ~ \'^[0-9]+\\.[0-9]+(\\.[0-9]+)?$\']']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (taxonomy_code) [unique]
  }
}

Table audience.activation [note: 'Operational record of an audience segment being activated (pushed) to a specific DSP, SSP, or media platform for campaign targeting. Captures activation date, target platform (The Trade Desk, DV360, Meta, etc.), segment ID, activation status (pending/active/expired/paused), estimated reach, match rate, activation method (pixel, API, S2S), and associated campaign reference. Tracks the operational lifecycle of audience deployment.'] {
  activation_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the audience activation record. Primary key.']
  activation_platform_audience_audience_segment_id uuid [note: 'External identifier assigned by the target platform (DSP/SSP) for this activated audience segment. [→ audience.segment]']
  activation_segment_id uuid [note: 'Reference to the audience segment being activated for targeting. [→ audience.segment]']
  asset_id uuid [note: 'Foreign key linking to creative.asset. Business justification: Activations push segments to DSPs/SSPs with specific creative; programmatic campaigns require asset-segment pairing for trafficking, and activation records must track which creative serves to each aud [→ work_mgmt_db.creative.asset (not enforced)]']
  budget_line_id uuid [note: 'Foreign key linking to finance.budget_line. Business justification: Each audience activation to a DSP/platform consumes a specific budget line (media spend allocation). Finance teams reconcile activation costs against budget lines. This link enables activation-level s [→ erp_db.finance.budget_line (not enforced)]']
  campaign_id uuid [note: 'Reference to the campaign for which this audience segment is being activated. [→ media_ops_db.campaign.campaign (not enforced)]']
  contract_insertion_order_id uuid [note: 'Foreign key linking to contract.contract_insertion_order. Business justification: Activations are executed under a contract insertion order that authorizes spend, flight dates, and placement specs. Linking activation to contract_insertion_order enables contractual compliance tracki [→ crm_db.contract.contract_insertion_order (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Activations carry cost_cpm and currency_code indicating direct media/data costs. Cost center attribution for audience activation spend is required for internal cost allocation, P&L reporting, and char [→ erp_db.finance.cost_center (not enforced)]']
  creative_deliverable_id uuid [note: 'Foreign key linking to creative.creative_deliverable. Business justification: Activations reference deliverables for media plan execution; trafficking workflows map segments to specific creative deliverables to ensure correct creative versions serve to each audience across chan [→ work_mgmt_db.creative.creative_deliverable (not enforced)]']
  flight_id uuid [note: 'Foreign key linking to campaign.flight. Business justification: Audience activations are executed within specific campaign flights. Linking activation to flight enables flight-level audience delivery reporting, frequency management, and reach measurement within sc [→ media_ops_db.campaign.flight (not enforced)]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Audience activations are often executed as part of broader project initiatives for budget tracking, timeline management, and deliverable coordination. Agencies track which project initiative funded an [→ work_mgmt_db.project.initiative (not enforced)]']
  line_item_id uuid [note: 'Foreign key linking to campaign.line_item. Business justification: Programmatic audience activations are executed at the line-item level. Buyers need to reconcile which audience activations drove delivery against specific line items for billing verification, performa [→ media_ops_db.campaign.line_item (not enforced)]']
  lookalike_model_id uuid [note: 'Foreign key linking to audience.lookalike_model. Business justification: When an audience activation pushes a lookalike-generated segment to a DSP or SSP, the activation record should reference the lookalike_model that produced the expanded audience. This enables performan [→ audience.lookalike_model]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Activations are executed through platform vendors (DSPs, social platforms, DMPs). Tracking which supplier/platform executed each activation is fundamental to reconciliation, performance reporting, inv [→ media_ops_db.vendor.supplier (not enforced)]']
  suppression_list_id uuid [note: 'Foreign key linking to audience.suppression_list. Business justification: audience_activation pushes segments to DSPs/SSPs. suppression_list defines identifiers to exclude from targeting. An activation should reference which suppression list was applied to ensure excluded i [→ audience.suppression_list]']
  tech_partner_id uuid [note: 'Foreign key linking to vendor.tech_partner. Business justification: Audience activations are executed through DSP/tech platforms. Knowing which tech partner executed each activation is required for platform fee reconciliation, troubleshooting sync errors (retry_count, [→ media_ops_db.vendor.tech_partner (not enforced)]']
  activation_date date [note: 'Date when the audience segment was activated and pushed to the target platform.']
  activation_method text [note: 'Technical method used to push the audience segment to the target platform. API = Application Programming Interface, S2S = Server-to-Server integration. [activation_method IN (\'API\', \'S2S\', \'Pixel\', \'File Upload\', \'Manual\')]']
  activation_name text [note: 'Business-friendly name or label for this activation instance.']
  activation_status text [not null, note: 'Current operational status of the audience activation in its lifecycle. [activation_status IN (\'Pending\', \'Active\', \'Paused\', \'Expired\', \'Failed\', \'Cancelled\')]']
  activation_timestamp timestamptz [note: 'Precise timestamp when the activation was initiated and the segment push began.']
  activation_type text [note: 'Classification of the activation purpose and targeting strategy. [activation_type IN (\'Standard\', \'Lookalike\', \'Suppression\', \'Retargeting\', \'Prospecting\')]']
  bid_modifier numeric(5,2) [note: 'Multiplier applied to base bid amounts for this audience segment (e.g., 1.25 = 25% bid increase, 0.80 = 20% bid decrease).']
  consent_framework text [note: 'Privacy consent framework applied to this activation. IAB TCF = Interactive Advertising Bureau Transparency and Consent Framework. [consent_framework IN (\'IAB TCF 2.0\', \'CCPA\', \'GDPR\', \'Custom\')]']
  consent_status text [note: 'Privacy consent status for the audience segment members at the time of activation, ensuring GDPR and CCPA compliance. [consent_status IN (\'Verified\', \'Pending\', \'Expired\', \'Revoked\')]']
  cost_cpm numeric(10,2) [note: 'Cost per thousand impressions charged by the data provider or platform for activating this audience segment. [cost_cpm >= 0]']
  currency_code char(3) [note: 'Three-letter ISO 4217 currency code for activation costs (e.g., USD, EUR, GBP). [currency_code ~ \'^[A-Z]{3}$\']']
  data_source_type text [note: 'Origin classification of the audience data being activated (first-party = owned, second-party = partner, third-party = purchased). [data_source_type IN (\'First-Party\', \'Second-Party\', \'Third-Party\')]']
  effective_end_date date [note: 'Date when the activated audience segment expires and is no longer available for targeting. Nullable for open-ended activations. [effective_end_date >= effective_start_date]']
  effective_start_date date [note: 'Date when the activated audience segment becomes available for targeting in campaigns.']
  error_message text [note: 'Detailed error or failure message if the activation encountered issues during processing or sync.']
  estimated_reach bigint [note: 'Estimated number of unique users or devices in the activated audience segment available for targeting. [estimated_reach >= 0]']
  frequency_cap integer [note: 'Maximum number of times an individual user in the activated segment should be exposed to campaign creative within the frequency window. [frequency_cap >= 0]']
  frequency_cap_window_hours integer [note: 'Time window in hours over which the frequency cap is applied. [frequency_cap_window_hours >= 0]']
  last_sync_timestamp timestamptz [note: 'Timestamp of the most recent successful synchronization of audience data to the target platform.']
  match_rate_percentage numeric(5,2) [note: 'Percentage of audience segment records successfully matched and recognized by the target platform, expressed as a decimal (e.g., 75.50 for 75.5%). [match_rate_percentage BETWEEN 0 AND 100]']
  matched_user_count bigint [note: 'Actual number of users or devices successfully matched by the target platform during activation. [matched_user_count >= 0]']
  next_sync_timestamp timestamptz [note: 'Scheduled timestamp for the next audience data synchronization to the target platform.']
  notes text [note: 'Free-form notes or comments about this activation for operational context and troubleshooting.']
  priority_level text [note: 'Business priority assigned to this activation for resource allocation and optimization decisions. [priority_level IN (\'High\', \'Medium\', \'Low\')]']
  retry_count integer [note: 'Number of retry attempts made for failed activations before marking as permanently failed. [retry_count >= 0]']
  sync_frequency text [note: 'Cadence at which the audience segment membership is refreshed and re-synced to the target platform. [sync_frequency IN (\'Real-Time\', \'Hourly\', \'Daily\', \'Weekly\', \'On-Demand\')]']
  unmatched_user_count bigint [note: 'Number of users or devices from the segment that could not be matched by the target platform. [unmatched_user_count >= 0]']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table audience.lookalike_model [note: 'Operational record of a lookalike audience model built from a seed segment — capturing seed segment reference, model algorithm type (cosine similarity, gradient boosting, neural net), expansion ratio, similarity threshold, model training date, model version, platform (The Trade Desk, DV360), estimated reach, validation accuracy, and model status. Enables scale expansion of high-value audience segments for prospecting campaigns.'] {
  lookalike_model_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the lookalike audience model record. Primary key for the lookalike model entity.']
  advertiser_id uuid [note: 'Reference to the advertiser or client account that owns this lookalike model for campaign use and billing purposes. [→ crm_db.client.advertiser (not enforced)]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Lookalike models are built for specific brands to expand reach among new audiences resembling existing brand customers. Brand managers need to track which lookalike models are active for their brand f [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [note: 'Optional reference to a specific campaign for which this lookalike model was created, enabling campaign-specific audience modeling strategies. [→ media_ops_db.campaign.campaign (not enforced)]']
  contract_insertion_order_id uuid [note: 'Foreign key linking to contract.contract_insertion_order. Business justification: Lookalike models are commissioned and billed under specific contract IOs in programmatic advertising. Linking to contract_insertion_order enables cost attribution, IO-level model performance reporting [→ crm_db.contract.contract_insertion_order (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Lookalike models carry model_cost and currency_code attributes. Cost center attribution for model development and licensing costs is required for internal P&L reporting and chargeback in agencies that [→ erp_db.finance.cost_center (not enforced)]']
  development_initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Lookalike model development is a distinct project deliverable with dedicated timelines, resources, and budgets. Agencies track which initiative funded model creation for cost recovery and to manage da [→ work_mgmt_db.project.initiative (not enforced)]']
  segment_id uuid [note: 'Reference to the source audience segment used as the foundation for building the lookalike model. The seed segment contains high-value users whose characteristics are modeled. [→ audience.segment]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Lookalike models are frequently built by third-party data science platforms or DSPs (e.g., Facebook, Trade Desk, LiveRamp). Tracking the supplier is essential for cost allocation, model performance at [→ media_ops_db.vendor.supplier (not enforced)]']
  taxonomy_id uuid [note: 'Foreign key linking to audience.taxonomy. Business justification: A lookalike model is built to expand a seed audience into a broader audience within a specific audience category. The taxonomy_id FK classifies the lookalike model under the standardized IAB Audience [→ audience.taxonomy]']
  tech_partner_id uuid [note: 'Foreign key linking to vendor.tech_partner. Business justification: Lookalike models are built and hosted on specific DSP/ML tech platforms. platform_name is a plain-text denormalization of the tech partner. FK enables model governance, platform fee tracking, and plat [→ media_ops_db.vendor.tech_partner (not enforced)]']
  algorithm_type text [note: 'Machine learning algorithm used to build the lookalike model. Determines the mathematical approach for identifying similar audience members. [→ ref.algorithm_type]']
  baseline_performance_value numeric(10,4) [note: 'Benchmark performance metric value from the seed segment, used to compare lookalike audience performance against the original high-value segment. [baseline_performance_value >= 0]']
  consent_compliant_flag boolean [not null, default: false, note: 'Indicates whether the lookalike model was built using only users who provided explicit consent for data usage under GDPR, CCPA, or other privacy regulations.']
  currency_code text [note: 'ISO 4217 three-letter currency code for the model cost and related financial metrics. [currency_code IN (\'USD\', \'EUR\', \'GBP\', \'CAD\', \'AUD\', \'JPY\')]']
  data_source_type text [note: 'Classification of the data used to build the seed segment and train the model. First-party is owned data; second-party is partner data; third-party is purchased data. [data_source_type IN (\'first_party\', \'second_party\', \'third_party\', \'hybrid\')]']
  estimated_reach bigint [note: 'Projected number of unique users or devices in the lookalike audience available for targeting across campaigns. [estimated_reach >= 0]']
  expansion_ratio numeric(5,2) [note: 'Multiplier indicating how many times larger the lookalike audience is compared to the seed segment (e.g., 10.00 means the lookalike is 10x the seed size). Used to balance reach vs. similarity.']
  expiration_date date [note: 'Date when the lookalike model is scheduled to expire and become unavailable for targeting unless refreshed or extended.']
  feature_set text [note: 'Comma-separated list of data attributes used as input features for model training (e.g., demographics, behavioral signals, purchase history, engagement metrics).']
  geographic_scope text [note: 'Geographic boundary for the lookalike audience (e.g., USA, CAN, GBR, global). Uses ISO 3166-1 alpha-3 country codes or \'global\' for worldwide reach.']
  last_refresh_date date [note: 'Date when the lookalike model was most recently retrained or refreshed with updated seed segment data.']
  model_cost numeric(15,2) [note: 'Total cost incurred to build and deploy the lookalike model, including data acquisition, platform fees, and computational resources. [model_cost >= 0]']
  model_description text [note: 'Detailed business description of the lookalike model purpose, target use cases, and strategic rationale for campaign planners and media buyers.']
  model_name text [not null, note: 'Business-friendly name assigned to the lookalike model for identification and campaign planning purposes.']
  model_status text [not null, note: 'Current lifecycle state of the lookalike model. Active models are available for campaign targeting; expired models require retraining. [model_status IN (\'draft\', \'training\', \'active\', \'paused\', \'expired\', \'archived\')]']
  model_version text [note: 'Version identifier for the lookalike model, enabling tracking of model iterations and A/B testing across versions.']
  next_refresh_date date [note: 'Scheduled date for the next model retraining cycle based on the refresh frequency policy.']
  performance_metric_type text [note: 'Primary Key Performance Indicator (KPI) used to evaluate the lookalike model effectiveness in campaigns. CTR = Click-Through Rate, CVR = Conversion Rate, ROAS = Return on Ad Spend, CPA = Cost Per Acquisition, LTV = Lifetime Value. [performance_metric_type IN (\'ctr\', \'cvr\', \'roas\', \'cpa\', \'engagement_rate\', \'ltv\')]']
  refresh_frequency_days integer [note: 'Number of days between scheduled model retraining cycles to maintain accuracy and relevance as audience behaviors evolve. [refresh_frequency_days >= 0]']
  similarity_threshold numeric(5,4) [note: 'Minimum similarity score (0.0000 to 1.0000) required for a user to be included in the lookalike audience. Higher thresholds produce smaller, more similar audiences.']
  training_date date [note: 'Date when the lookalike model was trained on the seed segment data. Critical for understanding model freshness and performance decay over time.']
  validation_accuracy numeric(5,4) [note: 'Model accuracy score (0.0000 to 1.0000) measured on a holdout validation dataset, indicating how well the model predicts high-value user characteristics.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table audience.segment_membership [note: 'Association record linking individual audience identifiers (cookie IDs, device IDs, hashed emails, MAIDs) to specific audience segments. Captures membership start date, expiry date, membership source, confidence score, inclusion/exclusion flag, and last refresh timestamp. Enables real-time segment population tracking and audience size reporting across DMP, CDP, and DSP platforms including The Trade Desk.'] {
  segment_membership_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the segment membership record. Primary key for the segment membership association.']
  budget_line_id uuid [note: 'Foreign key linking to finance.budget_line. Business justification: Segment membership has cost_per_member indicating data costs that must be tracked against a budget line. Audience data spend management requires linking membership costs to approved budget lines for v [→ erp_db.finance.budget_line (not enforced)]']
  cost_center_id uuid [note: 'Foreign key linking to finance.cost_center. Business justification: Segment membership records carry cost_per_member and currency_code, indicating per-member data costs. Cost center attribution is required for internal billing and data cost allocation reporting across [→ erp_db.finance.cost_center (not enforced)]']
  initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Segment membership records are generated during initiative execution (e.g., audience onboarding initiative, data partnership initiative). Linking membership to the originating initiative enables attri [→ work_mgmt_db.project.initiative (not enforced)]']
  segment_id uuid [not null, note: 'Reference to the specific audience segment that this identifier belongs to. Links to the audience segment definition in the DMP or CDP. [→ audience.segment]']
  supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: Segment membership data is sourced from third-party data suppliers. Media planners need supplier attribution per membership record for data cost reconciliation, quality audits, and GDPR data processor [→ media_ops_db.vendor.supplier (not enforced)]']
  tech_partner_id uuid [note: 'Foreign key linking to vendor.tech_partner. Business justification: Segment memberships are activated via DSP/tech platforms. dsp_platform is a plain-text denormalization of the tech partner. Linking to tech_partner enables platform fee reconciliation, activation trou [→ media_ops_db.vendor.tech_partner (not enforced)]']
  activation_status text [note: 'The status of this segment membership in the DSP or activation platform. Activated indicates the membership is live and available for targeting. Pending indicates activation is in progress. Failed indicates activation encountered an error. Deactivated indicates the membership has been removed from the activation platform. [activation_status IN (\'activated\', \'pending\', \'failed\', \'deactivated\')]']
  activation_timestamp timestamptz [note: 'The timestamp when this segment membership was successfully activated in the DSP or targeting platform. Used for activation latency analysis and real-time audience availability reporting.']
  audience_identifier text [not null, note: 'The individual audience identifier (cookie ID, device ID, hashed email, MAID, or other pseudonymous identifier) that is a member of the segment. This is the core identifier used for targeting and activation across DSP, DMP, and CDP platforms.']
  confidence_score numeric(5,4) [note: 'A numeric score between 0 and 1 representing the confidence or probability that the audience identifier truly belongs to this segment. Higher scores indicate stronger membership signals. Used for quality filtering and bid optimization in programmatic campaigns.']
  cost_per_member numeric(10,4) [note: 'The cost paid to acquire or license this specific segment membership from a third-party data provider, expressed in the campaign currency. Null for first-party segments. Used for data cost attribution and ROI analysis. [cost_per_member >= 0]']
  currency_code char(3) [note: 'The three-letter ISO 4217 currency code for the cost per member amount (e.g., USD, EUR, GBP). Used for multi-currency data cost reporting and financial reconciliation. [currency_code ~ \'^[A-Z]{3}$\']']
  device_type text [note: 'The type of device associated with this audience identifier. Desktop indicates traditional computer. Mobile indicates smartphone. Tablet indicates tablet device. CTV indicates Connected TV. OTT indicates Over-The-Top streaming device. Other indicates unclassified device. Used for device-specific targeting and cross-device attribution. [device_type IN (\'desktop\', \'mobile\', \'tablet\', \'ctv\', \'ott\', \'other\')]']
  frequency_cap integer [note: 'The maximum number of times this audience identifier should be exposed to ads from campaigns targeting this segment within a defined time period. Used for frequency management and preventing ad fatigue. Nullable if no cap is applied. [frequency_cap >= 0]']
  geographic_region text [note: 'The geographic region or market associated with this segment membership, if the segment has geographic targeting criteria. Used for geo-targeted campaign planning and regional audience analysis.']
  identifier_type text [not null, note: 'The type of audience identifier used for this membership record. Indicates whether the identifier is a cookie ID, mobile advertising ID (MAID), device ID, hashed email, customer ID, or household ID. [identifier_type IN (\'cookie_id\', \'device_id\', \'maid\', \'hashed_email\', \'customer_id\', \'household_id\')]']
  inclusion_flag boolean [not null, default: false, note: 'Boolean flag indicating whether this is an inclusion (true) or exclusion (false) membership. Inclusion memberships are targeted in campaigns; exclusion memberships are suppressed. Supports negative targeting and suppression list management.']
  last_refresh_timestamp timestamptz [note: 'The timestamp when this segment membership record was last refreshed or re-evaluated. Critical for real-time segment population tracking and ensuring audience data freshness for DSP activation.']
  match_rate numeric(5,4) [note: 'The rate at which this audience identifier successfully matched to the segment criteria, expressed as a decimal between 0 and 1. Used for data quality assessment and segment match performance analysis across DMP and CDP integrations. [match_rate >= 0]']
  membership_expiry_date date [note: 'The date when the segment membership expires or is scheduled to expire. Nullable for evergreen segments. Used for time-bound segment management and automated exclusion workflows.']
  membership_source text [note: 'The origin or derivation method of the segment membership. First-party indicates data collected directly by the advertiser. Second-party indicates data shared by a partner. Third-party indicates data purchased from a data provider. Modeled indicates membership derived from predictive modeling. Lookalike indicates membership based on similarity to a seed audience. Behavioral indicates membership based on observed actions. Contextual indicates membership based on content consumption. [→ ref.membership_source]']
  membership_start_date date [note: 'The date when the audience identifier first became a member of this segment. Used for recency analysis and segment freshness reporting.']
  membership_status text [not null, note: 'Current lifecycle status of the segment membership. Active indicates the identifier is currently in the segment and eligible for targeting. Expired indicates membership has lapsed. Excluded indicates the identifier has been explicitly removed. Pending indicates membership is being processed. Suppressed indicates the identifier is blocked from targeting due to consent or compliance rules. [membership_status IN (\'active\', \'expired\', \'excluded\', \'pending\', \'suppressed\')]']
  recency_days integer [note: 'The number of days since the audience identifier last exhibited the behavior or attribute that qualifies them for this segment. Used for recency-based targeting strategies and segment decay analysis. [recency_days >= 0]']
  segment_priority integer [note: 'A numeric priority ranking for this segment membership when the audience identifier belongs to multiple overlapping segments. Higher values indicate higher priority. Used for bid decisioning and creative selection when multiple segments apply.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']
}

Table audience.suppression_list [note: 'Audience suppression list record defining identifiers to be excluded from campaign targeting — including converted customers, opted-out users, competitor employees, brand safety exclusions, and frequency-capped audiences. Captures list name, suppression type, identifier type (hashed email, cookie, MAID), list size, source system, creation date, expiry date, and associated campaign or advertiser scope. Critical for privacy compliance and media efficiency.'] {
  suppression_list_id uuid [pk, not null, default: `uuidv7()`, note: 'Unique identifier for the suppression list record. Primary key.']
  advertiser_id uuid [note: 'Identifier of the advertiser to which this suppression list is scoped. Nullable if the list is shared across multiple advertisers. [→ crm_db.client.advertiser (not enforced)]']
  brand_id uuid [note: 'Foreign key linking to client.brand. Business justification: Suppression lists are brand-specific in multi-brand advertisers — Brand A\'s opted-out customers must not suppress Brand B campaigns. Brand-level suppression management is a standard privacy compliance [→ crm_db.client.brand (not enforced)]']
  campaign_id uuid [note: 'Identifier of the specific campaign to which this suppression list is applied. Nullable if the list is applied at advertiser or account level. [→ media_ops_db.campaign.campaign (not enforced)]']
  contract_insertion_order_id uuid [note: 'Foreign key linking to contract.contract_insertion_order. Business justification: Suppression lists are applied at the IO level in media buying — the IO specifies which suppression lists govern a given buy to prevent serving ads to opted-out or excluded audiences. This link enables [→ crm_db.contract.contract_insertion_order (not enforced)]']
  creation_initiative_id uuid [note: 'Foreign key linking to project.initiative. Business justification: Suppression list creation and maintenance is often a project task within compliance or campaign setup initiatives. Agencies track which project funded list development for billing and to manage data o [→ work_mgmt_db.project.initiative (not enforced)]']
  data_supplier_id uuid [note: 'Foreign key linking to vendor.supplier. Business justification: data_provider on suppression_list is a plain-text denormalization of the vendor supplier. Suppression list data is sourced from specific vendors (opt-out providers, CRM data vendors). FK enables vendo [→ media_ops_db.vendor.supplier (not enforced)]']
  enforcement_tech_partner_id uuid [note: 'Foreign key linking to vendor.tech_partner. Business justification: Suppression lists are synced to and enforced by specific DSP/tech platforms. platform_integration_status and platform_sync_timestamp on suppression_list confirm a platform relationship exists. Complia [→ media_ops_db.vendor.tech_partner (not enforced)]']
  flight_id uuid [note: 'Foreign key linking to campaign.flight. Business justification: Suppression lists are applied at the flight level to exclude opted-out users or existing customers from specific flight executions. Media planners need flight-level suppression control for granular au [→ media_ops_db.campaign.flight (not enforced)]']
  governing_agreement_id uuid [note: 'Foreign key linking to contract.agreement. Business justification: Suppression obligations are frequently contractually mandated (competitor exclusions, brand safety requirements, regulatory compliance). Critical for compliance verification, audit trails, and ensurin [→ crm_db.contract.agreement (not enforced)]']
  segment_id uuid [note: 'Foreign key linking to audience.segment. Business justification: Suppression lists are often derived from segments (e.g., \'suppress all users who converted\' or \'suppress all users in segment X\'). Adding source_segment_id tracks which segment the suppression list wa [→ audience.segment]']
  approval_status text [note: 'Approval workflow status for the suppression list (approved, pending, rejected). Lists must be approved before activation in campaigns. [approval_status IN (\'approved\', \'pending\', \'rejected\')]']
  approval_timestamp timestamptz [note: 'Timestamp when the suppression list was approved for use in campaigns.']
  archive_date date [note: 'Date when the suppression list was archived and removed from active campaign targeting systems.']
  consent_withdrawal_flag boolean [not null, default: false, note: 'Indicates whether the suppression list contains identifiers for users who have withdrawn marketing consent (True/False).']
  data_cost numeric(15,2) [note: 'Cost incurred to acquire or license the suppression list data from a third-party provider, in US Dollars (USD). [data_cost >= 0]']
  effective_end_date date [note: 'Date when the suppression list expires and is no longer applied to campaign targeting. Nullable for indefinite suppression lists. [effective_end_date >= effective_start_date]']
  effective_start_date date [note: 'Date from which the suppression list becomes active and is applied to campaign targeting.']
  frequency_cap_period text [note: 'Time period over which the frequency cap threshold is measured (hour, day, week, month, campaign lifetime). [frequency_cap_period IN (\'hour\', \'day\', \'week\', \'month\', \'campaign_lifetime\')]']
  frequency_cap_threshold integer [note: 'Maximum number of impressions or interactions allowed before an identifier is added to the suppression list. Applicable for frequency-capped suppression types. [frequency_cap_threshold >= 0]']
  hashing_algorithm text [note: 'Cryptographic hashing algorithm applied to identifiers for privacy protection (SHA256, MD5, SHA1, none if identifiers are not hashed). [hashing_algorithm IN (\'SHA256\', \'MD5\', \'SHA1\', \'none\')]']
  identifier_type text [note: 'Type of identifier stored in the suppression list (hashed email, cookie ID, Mobile Advertising ID (MAID), device ID, customer ID, IP address). Determines matching strategy in Demand-Side Platforms (DSPs) and Supply-Side Platforms (SSPs). [identifier_type IN (\'hashed_email\', \'cookie_id\', \'mobile_advertising_id\', \'device_id\', \'customer_id\', \'ip_address\')]']
  last_refresh_timestamp timestamptz [note: 'Timestamp of the most recent data refresh or sync operation for this suppression list.']
  list_code text [not null, note: 'Unique business code or external identifier for the suppression list used in campaign systems and Data Management Platforms (DMPs).']
  list_name text [not null, note: 'Business-friendly name of the suppression list (e.g., \'Q4 Converted Customers\', \'GDPR Opt-Out Master\', \'Competitor Employees\').']
  list_size bigint [note: 'Total count of unique identifiers in the suppression list. Used for reach estimation and media planning. [list_size >= 0]']
  list_status text [not null, note: 'Current lifecycle status of the suppression list (active, inactive, expired, pending approval, archived). Only active lists are applied to campaign targeting. [list_status IN (\'active\', \'inactive\', \'expired\', \'pending_approval\', \'archived\')]']
  match_rate_percentage numeric(5,2) [note: 'Percentage of identifiers in the suppression list that successfully matched against campaign targeting pools in Demand-Side Platforms (DSPs) or Data Management Platforms (DMPs). Used to assess list quality and reach impact. [match_rate_percentage BETWEEN 0 AND 100]']
  notes text [note: 'Free-form notes or comments about the suppression list for internal reference, including special handling instructions or business context.']
  platform_integration_status text [note: 'Status of the suppression list synchronization with downstream advertising platforms such as Demand-Side Platforms (DSPs), Supply-Side Platforms (SSPs), or ad servers (synced, pending sync, sync failed, not applicable). [platform_integration_status IN (\'synced\', \'pending_sync\', \'sync_failed\', \'not_applicable\')]']
  platform_sync_timestamp timestamptz [note: 'Timestamp of the most recent successful synchronization of the suppression list to downstream advertising platforms.']
  privacy_compliance_flag boolean [not null, default: false, note: 'Indicates whether the suppression list was created to satisfy privacy regulations such as General Data Protection Regulation (GDPR) or California Consumer Privacy Act (CCPA) opt-out requests (True/False).']
  refresh_frequency text [note: 'Cadence at which the suppression list is refreshed or re-synced from the source system (daily, weekly, monthly, quarterly, on-demand, real-time). [refresh_frequency IN (\'daily\', \'weekly\', \'monthly\', \'quarterly\', \'on_demand\', \'real_time\')]']
  retention_period_days integer [note: 'Number of days the suppression list and its identifiers are retained before automatic archival or deletion, per data retention policies and privacy regulations. [retention_period_days >= 0]']
  scope_level text [note: 'Organizational level at which the suppression list is applied (global across all advertisers, advertiser-specific, campaign-specific, line-item-specific). [scope_level IN (\'global\', \'advertiser\', \'campaign\', \'line_item\')]']
  source_file_name text [note: 'Name of the file or data feed from which the suppression list was ingested, if applicable. Supports audit and lineage tracking.']
  source_system text [note: 'Originating system or platform that generated the suppression list (e.g., \'Salesforce CRM\', \'The Trade Desk\', \'Adobe Audience Manager\', \'Google Campaign Manager 360\', \'Internal CRM\').']
  suppression_list_description text [note: 'Detailed business description of the suppression list purpose, use case, and any special handling instructions.']
  suppression_type text [note: 'Category of suppression defining why identifiers are excluded from targeting (converted customer, opted-out user, frequency-capped audience, competitor employee, brand safety exclusion, fraud prevention). [suppression_type IN (\'converted_customer\', \'opted_out\', \'frequency_capped\', \'competitor_employee\', \'brand_safety\', \'fraud_prevention\')]']
  creation_date date [note: 'Date when the suppression list was first created in the system.']
  created_at timestamptz [not null, default: `now()`, note: 'Timestamp when the row was inserted. Set by default, immutable (enforced by audit trigger).']
  created_by text [not null, default: `audit.current_actor()`, note: 'Application user (session setting app.actor) or database role that inserted the row. Immutable.']
  updated_at timestamptz [not null, default: `now()`, note: 'Timestamp of the last update. Maintained by the audit trigger.']
  updated_by text [not null, default: `audit.current_actor()`, note: 'Application user or database role that last updated the row. Maintained by the audit trigger.']

  indexes {
    (list_code) [unique]
  }
}

Ref: audience.behavioral_profile.primary_behavioral_audience_segment_id > audience.segment.segment_id
Ref: audience.behavioral_profile.primary_taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.behavioral_profile.tertiary_behavioral_lookalike_seed_segment_audience_segment_id > audience.segment.segment_id
Ref: audience.demographic_profile.primary_demographic_audience_segment_id > audience.segment.segment_id
Ref: audience.demographic_profile.taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.demographic_profile.employment_category > ref.employment_category.code
Ref: audience.persona.behavioral_profile_id > audience.behavioral_profile.behavioral_profile_id
Ref: audience.persona.demographic_profile_id > audience.demographic_profile.demographic_profile_id
Ref: audience.persona.primary_audience_segment_id > audience.segment.segment_id
Ref: audience.persona.taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.segment.taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.segment.education_level > ref.education_level.code
Ref: audience.segment.income_tier > ref.income_tier.code
Ref: audience.segment.vals_segment > ref.vals_segment.code
Ref: audience.taxonomy.parent_taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.taxonomy.primary_replacement_taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.activation.activation_platform_audience_audience_segment_id > audience.segment.segment_id
Ref: audience.activation.activation_segment_id > audience.segment.segment_id
Ref: audience.activation.lookalike_model_id > audience.lookalike_model.lookalike_model_id
Ref: audience.activation.suppression_list_id > audience.suppression_list.suppression_list_id
Ref: audience.lookalike_model.segment_id > audience.segment.segment_id
Ref: audience.lookalike_model.taxonomy_id > audience.taxonomy.taxonomy_id
Ref: audience.lookalike_model.algorithm_type > ref.algorithm_type.code
Ref: audience.segment_membership.segment_id > audience.segment.segment_id
Ref: audience.segment_membership.membership_source > ref.membership_source.code
Ref: audience.suppression_list.segment_id > audience.segment.segment_id

